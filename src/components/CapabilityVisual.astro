---
/**
 * Illustrations for the four disciplines on the home page: a pixel-mosaic backdrop in the
 * discipline's colour with a small product mock-up on top. Everything scales with the
 * container (cqw units), so it reads the same on a phone and a wide screen.
 * The mock-ups are illustrative — they echo the case studies, they are not screenshots.
 */
import PixelArt from './PixelArt.astro';
import PixelGrid from './PixelGrid.astro';

interface Props {
  variant: 'ml' | 'ios' | 'web' | 'cloud';
}

const { variant } = Astro.props;

const palettes = {
  ml: ['#8fe3bf', '#6fd5a8', '#4fc490', '#b5efd5', '#3eb67e'],
  ios: ['#a8d2ff', '#7dbcfb', '#4a9ff2', '#cfe6ff', '#2d8ff0'],
  web: ['#ff7a1a', '#ff8f3a', '#ff6a0d', '#ffa45c', '#f25a07'],
  cloud: ['#ffd34d', '#ffc21a', '#ffe17a', '#ffb800', '#ffcf33'],
};
const seeds = { ml: 3, ios: 11, web: 23, cloud: 41 };

type CodeLine = { k?: string; v?: string; c?: string; i?: number; raw?: string };

const mlCode: CodeLine[] = [
  { c: '# npcmotion — inference tier' },
  { k: 'service', v: 'motion-inference' },
  { k: 'models' },
  { i: 1, raw: '- hy-motion' },
  { i: 1, raw: '- kimodo' },
  { k: 'compute', v: 'serverless-gpu', c: '# modal' },
  { k: 'scale_to_zero', v: 'true' },
  { k: 'orchestrator', v: 'phoenix' },
  { k: 'output_rig', v: 'roblox-r15' },
];

const metalCode = [
  'fragment float4 windowLevel(',
  '  VertexOut in [[stage_in]],',
  '  texture2d<float> slice [[texture(0)]],',
  '  constant Window &w [[buffer(0)]]) {',
  '  float v = slice.sample(s, in.uv).r;',
  '  return float4(float3(',
  '    saturate((v - w.lo) / w.width)), 1);',
  '}',
];

/* GPU worker load over time: idle, a burst of jobs, back to zero. */
const gpuBars = [0, 0, 1, 3, 6, 8, 7, 5, 6, 3, 1, 0];
/* Deploy time per release, before and after the pipeline rebuild. */
const deployBars = [10, 9, 10, 8, 9, 3, 3, 2, 3, 3];
---

<div class:list={['cv', `cv-${variant}`]} aria-hidden="true" data-reveal-hook>
  <PixelGrid colors={palettes[variant]} seed={seeds[variant]} class="cv-bg" />

  {variant === 'ml' && (
    <>
      <div class="cv-window cv-ml-code">
        <div class="cv-titlebar">
          <span class="cv-dots"><i></i><i></i><i></i></span>
          <span>inference.yaml</span>
        </div>
        <div class="cv-code">{mlCode.map((line, n) => (
          <span class="cv-line" style={`--n:${n}`}><span class="ln">{n + 1}</span>{'  '.repeat(line.i ?? 0)}{line.raw && <span class="v">{line.raw}</span>}{line.k && <span class="k">{line.k}:</span>}{line.v && <span class="v"> {line.v}</span>}{line.c && <span class="c">{line.k ? '  ' : ''}{line.c}</span>}</span>
        ))}</div>
      </div>
      <div class="cv-card cv-ml-gpu">
        <div class="cv-card-head">
          <PixelArt name="chip" scale={3} />
          <span>GPU workers</span>
        </div>
        <div class="cv-bars">
          {gpuBars.map((h, n) => (
            <span class="cv-bar" style={`--h:${h};--d:${n * 0.12}s`}></span>
          ))}
        </div>
        <span class="cv-card-foot">idle → burst → zero</span>
      </div>
    </>
  )}

  {variant === 'ios' && (
    <>
      <div class="cv-phone">
        <div class="cv-phone-screen">
          <div class="cv-phone-bar"><span>Series 2</span><span>Axial</span></div>
          <div class="cv-scan"><PixelArt name="scan" scale={8} /></div>
          <div class="cv-slider"><span>W/L</span><i></i></div>
          <div class="cv-thumbs"><i></i><i class="on"></i><i></i><i></i></div>
        </div>
      </div>
      <div class="cv-window cv-ios-code">
        <div class="cv-titlebar">
          <span class="cv-dots"><i></i><i></i><i></i></span>
          <span>WindowLevel.metal</span>
        </div>
        <div class="cv-code">{metalCode.map((line, n) => (
          <span class="cv-line" style={`--n:${n}`}><span class="ln">{n + 1}</span><span class="v">{line}</span></span>
        ))}</div>
      </div>
      <span class="node-tag cv-tag cv-ios-tag">+35% retention</span>
    </>
  )}

  {variant === 'web' && (
    <>
      <svg class="cv-wires" viewBox="0 0 100 60" preserveAspectRatio="none">
        <path d="M 12 11 H 32 V 21" />
        <path d="M 86 9 H 70 V 21" />
        <path d="M 9 44 H 26" />
        <path d="M 91 38 H 74" />
        <path d="M 50 54 V 49" />
      </svg>
      <span class="cv-tile" style="left:8%;top:12%"><PixelArt name="cube" scale={2} /></span>
      <span class="cv-tile" style="left:83%;top:9%"><PixelArt name="browser" scale={2} /></span>
      <span class="cv-tile" style="left:5%;top:66%"><PixelArt name="chart" scale={2} /></span>
      <span class="cv-tile" style="left:88%;top:56%"><PixelArt name="bolt" scale={2} /></span>
      <span class="cv-tile cv-tile-sm" style="left:47%;top:88%"><PixelArt name="rocket" scale={2} /></span>

      <div class="cv-prompt">
        <div class="cv-input">
          <span class="cv-plus">+</span>
          <span class="cv-placeholder">Drop a 3D model to convert…</span>
          <span class="cv-send"><PixelArt name="arrow" scale={2} /></span>
        </div>
        <ul class="cv-menu">
          <li><PixelArt name="cube" scale={1} /> Convert scene.fbx to glTF</li>
          <li><PixelArt name="browser" scale={1} /> Render an interactive preview</li>
          <li><PixelArt name="chart" scale={1} /> Export STL for printing</li>
        </ul>
      </div>
    </>
  )}

  {variant === 'cloud' && (
    <>
      <span class="cv-label" style="left:5%;top:9%">K8s cluster</span>
      <span class="cv-label" style="left:72%;top:9%">Redis cache</span>
      <span class="cv-label" style="left:5%;top:86%">RabbitMQ</span>
      <span class="cv-label" style="left:66%;top:86%">GitHub Actions</span>

      <div class="cv-window cv-cluster">
        <div class="cv-titlebar">
          <span class="cv-dots"><i></i><i></i><i></i></span>
          <span>production</span>
          <span class="cv-health"><i></i>healthy</span>
        </div>
        <div class="cv-services">
          {['gateway', 'inventory', 'orders', 'auth', 'worker', 'worker'].map((svc) => (
            <span class="cv-svc"><PixelArt name="server" scale={2} />{svc}</span>
          ))}
        </div>
      </div>
      <div class="cv-card cv-deploy">
        <div class="cv-card-head">
          <span>Deploy time</span>
          <strong>−70%</strong>
        </div>
        <div class="cv-bars cv-bars-deploy">
          {deployBars.map((h, n) => (
            <span class:list={['cv-bar', { after: n >= 5 }]} style={`--h:${h};--d:${n * 0.1}s`}></span>
          ))}
        </div>
        <span class="cv-card-foot">per release · CI/CD rebuilt</span>
      </div>
    </>
  )}
</div>

<style>
  .cv {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 3;
    overflow: hidden;
    container-type: inline-size;
    isolation: isolate;
    font-family: var(--font-mono);
  }

  .cv :global(.cv-bg) {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Entrance: chrome rises in, code types in line by line, once the panel is in view */
  .cv-window,
  .cv-card,
  .cv-phone,
  .cv-prompt,
  .cv-tile,
  .cv-label,
  .cv-tag {
    transition:
      opacity 0.7s ease,
      translate 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cv-card,
  .cv-tag,
  .cv-label {
    transition-delay: 0.35s;
  }

  :global(html.js-motion) .cv:not(.is-in) :is(.cv-window, .cv-card, .cv-phone, .cv-prompt, .cv-tile, .cv-label, .cv-tag) {
    opacity: 0;
    translate: 0 4cqw;
  }

  .cv-line {
    transition: opacity 0.05s;
    transition-delay: calc(0.5s + var(--n, 0) * 0.11s);
  }

  :global(html.js-motion) .cv:not(.is-in) .cv-line {
    opacity: 0;
  }

  /* ---------- Shared window + card chrome ---------- */
  .cv-window {
    position: absolute;
    background-color: #121214;
    border: 1px solid rgba(0, 0, 0, 0.35);
    border-radius: 0.9cqw;
    box-shadow: 0 2cqw 4cqw rgba(0, 0, 0, 0.28);
    overflow: hidden;
    color: var(--fg);
  }

  .cv-titlebar {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    padding: 1.1cqw 1.6cqw;
    border-bottom: 1px solid #26262b;
    font-size: clamp(8px, 1.55cqw, 12px);
    color: var(--muted);
  }

  .cv-dots {
    display: inline-flex;
    gap: 0.6cqw;
  }

  .cv-dots i {
    width: 0.9cqw;
    height: 0.9cqw;
    background-color: #3a3a40;
  }

  .cv-dots i:first-child {
    background-color: var(--px-red);
  }

  .cv-dots i:nth-child(2) {
    background-color: var(--px-amber);
  }

  .cv-dots i:nth-child(3) {
    background-color: var(--px-green);
  }

  .cv-code {
    margin: 0;
    padding: 1.6cqw 2cqw 1.8cqw 1.2cqw;
    font-family: var(--font-mono);
    font-size: clamp(8px, 1.75cqw, 13px);
    line-height: 1.65;
    white-space: pre;
    overflow: hidden;
  }

  .cv-line {
    display: block;
    min-height: 1.65em;
  }

  .cv-line .ln {
    display: inline-block;
    width: 3.2ch;
    color: #4a4a52;
    text-align: right;
    margin-right: 1.6ch;
    user-select: none;
  }

  .cv-line .k {
    color: var(--px-mint);
  }

  .cv-line .v {
    color: var(--fg);
  }

  .cv-line .c {
    color: #6a6a72;
  }

  .cv-card {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 1.2cqw;
    padding: 1.8cqw;
    background-color: #121214;
    border-radius: 0.9cqw;
    box-shadow: 0 2cqw 4cqw rgba(0, 0, 0, 0.28);
    color: var(--fg);
  }

  .cv-card-head {
    display: flex;
    align-items: center;
    gap: 1.2cqw;
    font-size: clamp(8px, 1.6cqw, 12px);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .cv-card-head :global(svg) {
    width: 3.6cqw;
    height: auto;
  }

  .cv-card-foot {
    font-size: clamp(7px, 1.35cqw, 11px);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .cv-bars {
    display: flex;
    align-items: flex-end;
    gap: 0.55cqw;
    height: 9cqw;
    border-bottom: 1px solid #2c2c32;
  }

  .cv-bar {
    flex: 1;
    height: calc(var(--h) * 1.1cqw + 2px);
    background-color: var(--px-green);
    transform-origin: bottom;
    animation: cv-bar 3.2s var(--d) ease-in-out infinite;
  }

  @keyframes cv-bar {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(0.72); }
  }

  /* ---------- ML ---------- */
  .cv-ml-code {
    left: 37%;
    top: 10%;
    width: 57%;
  }

  .cv-ml-gpu {
    left: 6%;
    bottom: 10%;
    width: 33%;
  }

  /* ---------- iOS ---------- */
  .cv-phone {
    position: absolute;
    left: 9%;
    top: 7%;
    width: 25%;
    aspect-ratio: 9 / 17.5;
    padding: 1.3cqw;
    background-color: #0d0d0f;
    border-radius: 4cqw;
    box-shadow: 0 2cqw 4cqw rgba(0, 0, 0, 0.3);
  }

  .cv-phone-screen {
    display: flex;
    flex-direction: column;
    gap: 1.6cqw;
    height: 100%;
    padding: 3.2cqw 1.8cqw 1.8cqw;
    background-color: #050507;
    border-radius: 3cqw;
  }

  .cv-phone-bar {
    display: flex;
    justify-content: space-between;
    font-size: clamp(6px, 1.3cqw, 10px);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--px-sky);
  }

  .cv-scan {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background-color: #000;
  }

  .cv-scan :global(svg) {
    width: 88%;
    height: auto;
  }

  .cv-slider {
    display: flex;
    align-items: center;
    gap: 1cqw;
    font-size: clamp(6px, 1.2cqw, 10px);
    color: var(--muted);
  }

  .cv-slider i {
    position: relative;
    flex: 1;
    height: 0.5cqw;
    background-color: #2a2a30;
  }

  .cv-slider i::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 62%;
    height: 100%;
    background-color: var(--px-sky);
    animation: cv-slide 4s ease-in-out infinite;
  }

  @keyframes cv-slide {
    0%, 100% { width: 62%; }
    50% { width: 38%; }
  }

  .cv-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8cqw;
    margin-top: auto;
  }

  .cv-thumbs i {
    aspect-ratio: 1;
    background-color: #1d1d22;
  }

  .cv-thumbs i.on {
    background-color: var(--px-blue);
  }

  .cv-ios-code {
    right: 5%;
    top: 22%;
    width: 56%;
  }

  .cv-tag {
    position: absolute;
    font-size: clamp(8px, 1.6cqw, 12px);
  }

  .cv-ios-tag {
    right: 8%;
    bottom: 10%;
  }

  /* ---------- Web ---------- */
  .cv-wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cv-wires path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.85);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .cv-tile {
    position: absolute;
    display: grid;
    place-items: center;
    width: 7cqw;
    height: 7cqw;
    background-color: rgba(255, 255, 255, 0.22);
    transform: translate(-50%, -50%);
  }

  .cv-tile-sm {
    width: 6cqw;
    height: 6cqw;
  }

  .cv-tile :global(svg) {
    width: 3.4cqw;
    height: auto;
  }

  .cv-prompt {
    position: absolute;
    left: 26%;
    top: 35%;
    width: 48%;
    display: flex;
    flex-direction: column;
    gap: 1.2cqw;
    font-family: var(--font-sans);
  }

  .cv-input,
  .cv-menu {
    background-color: #ffffff;
    border-radius: 0.8cqw;
    box-shadow: 0 1.5cqw 3cqw rgba(120, 40, 0, 0.25);
    color: #1a1a1d;
  }

  .cv-input {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    padding: 1.2cqw 1.2cqw 1.2cqw 1.6cqw;
    font-size: clamp(8px, 1.7cqw, 13px);
  }

  .cv-plus {
    display: grid;
    place-items: center;
    width: 3.6cqw;
    height: 3.6cqw;
    border: 1px solid #dedee2;
    border-radius: 0.6cqw;
    color: #1a1a1d;
  }

  .cv-placeholder {
    flex: 1;
    color: #9a9aa2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cv-send {
    display: grid;
    place-items: center;
    width: 3.6cqw;
    height: 3.6cqw;
    background-color: #1a1a1d;
    border-radius: 0.6cqw;
    color: #ffffff;
    transform: rotate(-90deg);
  }

  .cv-send :global(svg) {
    width: 1.6cqw;
    height: auto;
  }

  .cv-menu {
    display: flex;
    flex-direction: column;
    gap: 0.2cqw;
    padding: 1cqw 1.6cqw;
    font-size: clamp(8px, 1.55cqw, 12px);
  }

  .cv-menu li {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    padding: 0.9cqw 0;
    white-space: nowrap;
  }

  .cv-menu li :global(svg) {
    width: 2.2cqw;
    height: auto;
  }

  /* ---------- Cloud ---------- */
  .cv-label {
    position: absolute;
    font-size: clamp(7px, 1.4cqw, 11px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #9a5b00;
  }

  .cv-cluster {
    left: 8%;
    top: 20%;
    width: 52%;
  }

  .cv-health {
    display: inline-flex;
    align-items: center;
    gap: 0.6cqw;
    margin-left: auto;
    color: var(--px-mint);
  }

  .cv-health i {
    width: 0.9cqw;
    height: 0.9cqw;
    background-color: var(--px-green);
    animation: cv-blink 1.6s steps(2, jump-none) infinite;
  }

  @keyframes cv-blink {
    50% { opacity: 0.25; }
  }

  .cv-services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1cqw;
    padding: 1.6cqw;
  }

  .cv-svc {
    display: flex;
    align-items: center;
    gap: 1cqw;
    padding: 1.3cqw 1.2cqw;
    background-color: #1b1b1f;
    border: 1px solid #2a2a30;
    font-size: clamp(7px, 1.4cqw, 11px);
    color: var(--fg-soft);
    white-space: nowrap;
    overflow: hidden;
  }

  .cv-svc :global(svg) {
    width: 2.4cqw;
    height: auto;
  }

  .cv-deploy {
    right: 6%;
    top: 34%;
    width: 30%;
  }

  .cv-deploy .cv-card-head {
    justify-content: space-between;
  }

  .cv-deploy strong {
    font-family: var(--font-sans);
    font-size: clamp(12px, 3.2cqw, 24px);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--px-amber);
  }

  .cv-bars-deploy .cv-bar {
    background-color: #3a3a42;
    animation: none;
  }

  .cv-bars-deploy .cv-bar.after {
    background-color: var(--px-amber);
  }
</style>
