---
import { studio } from '../data/studio';
---

<section class="cta-section">
  <div class="cta-content">
    <h2 class="cta-headline">
      Got something to build?<br />
      Let's scope it properly.
    </h2>
    <p class="cta-sub">
      Reach the studio at <a href={`mailto:${studio.email}`} class="cta-email">{studio.email}</a>
    </p>
    <div class="cta-meta">
      <span class="cta-meta-item">{studio.location}</span>
      <span class="cta-meta-item">Est. {studio.founded}</span>
      <a href={`tel:${studio.phoneHref}`} class="cta-meta-item cta-meta-link">{studio.phone}</a>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-col">
      <span class="footer-label">/CONTENT</span>
      <ul>
        <li><a href="/">Work</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/legal">Legal notice</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <span class="footer-label">/SOCIAL</span>
      <ul>
        <li><a href={studio.github} target="_blank" rel="noopener">GitHub</a></li>
        <li><a href={studio.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={`mailto:${studio.email}`}>Email</a></li>
        <li><a href={`tel:${studio.phoneHref}`}>{studio.phone}</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <span class="footer-label">/STUDIO</span>
      <ul>
        <li><a href={studio.url} target="_blank" rel="noopener">{studio.domain}</a></li>
        <li><span>Product Engineering</span></li>
        <li><span>{studio.location}</span></li>
        <li><span>Est. {studio.founded}</span></li>
      </ul>
    </div>
    <div class="footer-col">
      <span class="footer-label">/ABOUT</span>
      <p class="footer-about-text">
        {studio.name} is the product engineering practice of {studio.principal} — ML inference
        infrastructure, iOS and real-time graphics, and the cloud platforms underneath. One exit,
        six shipped iOS apps, £50K+ in product revenue.
      </p>
    </div>
  </div>
</footer>

<style>
  /* CTA Section */
  .cta-section {
    background-color: var(--color-dark);
    color: var(--color-white);
    padding: 5rem 1.25rem 6rem;
  }

  .cta-content {
    max-width: 900px;
  }

  .cta-headline {
    font-family: var(--font-sans);
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  .cta-sub {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-gray-700);
  }

  .cta-email {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.2s;
  }

  .cta-email:hover {
    opacity: 0.7;
  }

  .cta-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .cta-meta-item {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
  }

  .cta-meta-link {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s;
  }

  .cta-meta-link:hover {
    opacity: 0.7;
  }

  /* Footer */
  .site-footer {
    background-color: var(--color-dark);
    color: var(--color-white);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2.5rem 1.25rem 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-gray-700);
    margin-bottom: 0.25rem;
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .footer-col a,
  .footer-col span {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-white);
    transition: opacity 0.2s;
  }

  .footer-col a:hover {
    opacity: 0.6;
  }

  .footer-about-text {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
