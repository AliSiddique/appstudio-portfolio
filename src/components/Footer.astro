---
import { studio } from '../data/studio';
import PixelArt from './PixelArt.astro';

const startMailto = `mailto:${studio.email}?subject=${encodeURIComponent('New project')}`;

/*
 * The skyline: one column of stacked squares per entry, coloured by height —
 * crimson at street level up to yellow at the top. 32 columns on wide screens; the
 * second half is dropped on phones.
 */
const heights = [
  2, 1, 1, 3, 2, 4, 2, 1, 2, 3, 5, 3, 2, 1, 1, 2,
  3, 2, 4, 3, 1, 2, 2, 5, 4, 2, 1, 3, 2, 1, 2, 3,
];
const levelColor = ['#d3290f', '#ff5228', '#ff8103', '#ffaf02', '#ffd21f'];
const year = new Date().getFullYear();
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta-inner">
    <span class="eyebrow">/ Start a project</span>
    <h2 class="statement cta-title" id="cta-title">
      Got something to build?<br />
      <span class="cta-dim">Let's scope it properly.</span>
    </h2>
    <div class="cta-actions">
      <a href={startMailto} class="btn btn-light">
        Get in touch
        <PixelArt name="chev" scale={2} class="chev" />
      </a>
      <a href="/services" class="btn">
        See services
        <PixelArt name="chev" scale={2} class="chev" />
      </a>
    </div>
    <a href={`mailto:${studio.email}`} class="cta-email">{studio.email}</a>
  </div>

  <div class="skyline" aria-hidden="true">
    {heights.map((h, col) => (
      <div class:list={['sky-col', { 'sky-wide': col >= 16 }]}>
        {Array.from({ length: h }, (_, level) => (
          <span class="sky-cell" style={`background-color:${levelColor[level]}`}></span>
        ))}
        {col === 10 && <PixelArt name="robot" scale={3} class="sky-sprite" />}
        {col === 23 && <PixelArt name="rack" scale={3} class="sky-sprite" />}
        {col === 5 && <PixelArt name="phone" scale={3} class="sky-sprite" />}
      </div>
    ))}
  </div>
</section>

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-cell footer-brand">
      <a href="/" class="footer-logo">
        <PixelArt name="logo" scale={4} />
        <span>{studio.name}</span>
      </a>
      <p class="footer-about">
        The product engineering practice of {studio.principal} — ML inference infrastructure,
        iOS and real-time graphics, and the cloud platforms underneath. One exit, six shipped iOS
        apps, £50K+ in product revenue.
      </p>
    </div>
    <div class="footer-cell">
      <span class="eyebrow">/ Content</span>
      <ul class="footer-links">
        <li><a href="/">Work</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/blog">Blog</a></li>
      </ul>
    </div>
    <div class="footer-cell">
      <span class="eyebrow">/ Contact</span>
      <ul class="footer-links">
        <li><a href={`mailto:${studio.email}`}>Email</a></li>
        <li><a href={startMailto}>Start a project</a></li>
      </ul>
    </div>
    <div class="footer-cell">
      <span class="eyebrow">/ Studio</span>
      <ul class="footer-links">
        <li><span>Product engineering</span></li>
        <li><span>Est. {studio.founded}</span></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/legal">Legal notice</a></li>
      </ul>
    </div>
  </div>
  <div class="wordmark" aria-hidden="true">
    <svg viewBox="0 0 1000 172" xmlns="http://www.w3.org/2000/svg" focusable="false">
      <defs>
        <linearGradient id="wordmark-ramp" gradientUnits="userSpaceOnUse" x1="0" y1="8" x2="0" y2="168">
          <stop offset="0" stop-color="#ffd21f" />
          <stop offset="0.2" stop-color="#ffd21f" />
          <stop offset="0.2" stop-color="#ffaf02" />
          <stop offset="0.4" stop-color="#ffaf02" />
          <stop offset="0.4" stop-color="#ff8103" />
          <stop offset="0.6" stop-color="#ff8103" />
          <stop offset="0.6" stop-color="#ff5228" />
          <stop offset="0.8" stop-color="#ff5228" />
          <stop offset="0.8" stop-color="#d3290f" />
          <stop offset="1" stop-color="#d3290f" />
        </linearGradient>
      </defs>
      <text x="0" y="168" textLength="1000" lengthAdjust="spacingAndGlyphs" fill="url(#wordmark-ramp)">SALINASH</text>
    </svg>
  </div>

  <div class="footer-base">
    <span>© {year} {studio.name}</span>
    <a href="#top" class="to-top">
      Back to top
      <PixelArt name="chev" scale={2} class="chev chev-up" />
    </a>
  </div>
</footer>

<style>
  /* CTA */
  .cta {
    position: relative;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    padding: clamp(4.5rem, 10vw, 8rem) 1.25rem clamp(3.5rem, 7vw, 5.5rem);
    text-align: center;
  }

  .cta-title {
    font-size: clamp(2.75rem, 7.4vw, 8rem);
  }

  .cta-dim {
    color: var(--muted);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .cta-email {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s;
  }

  .cta-email:hover {
    color: var(--fg);
  }

  /* Skyline */
  .skyline {
    display: grid;
    grid-template-columns: repeat(32, 1fr);
    align-items: end;
  }

  .sky-col {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
  }

  .sky-cell {
    display: block;
    aspect-ratio: 1;
  }

  .sky-col :global(.sky-sprite) {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--line);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
  }

  .footer-cell {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.5rem 1.5rem 3rem;
    border-right: 1px solid var(--line);
  }

  .footer-cell:last-child {
    border-right: none;
  }

  .footer-brand {
    padding-left: var(--gutter);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .footer-about {
    max-width: 44ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a,
  .footer-links span {
    font-size: 0.9375rem;
    color: var(--fg-soft);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  .wordmark {
    padding: clamp(1.5rem, 3vw, 3rem) clamp(1rem, 2vw, 2rem) clamp(1rem, 2vw, 2rem);
    border-top: 1px solid var(--line);
  }

  .wordmark svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .wordmark text {
    font-family: var(--font-sans);
    font-size: 230px;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .footer-base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.5rem 1.125rem var(--gutter);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.2s;
  }

  .to-top:hover {
    color: var(--fg);
  }

  .to-top :global(.chev-up) {
    transform: rotate(-90deg);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
      border-right: none;
      border-bottom: 1px solid var(--line);
      padding-left: 1.5rem;
    }

    .footer-base {
      padding-left: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .skyline {
      grid-template-columns: repeat(16, 1fr);
    }

    .sky-wide {
      display: none;
    }

    .sky-col :global(.sky-sprite) {
      width: 24px;
      height: auto;
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-cell {
      border-right: none;
      border-bottom: 1px solid var(--line);
      padding: 2rem 1rem;
    }

    .footer-cell:last-child {
      border-bottom: none;
    }

    .footer-base {
      padding: 1rem;
    }
  }
</style>
