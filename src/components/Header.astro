---
interface Props {
  activePage?: 'work' | 'about';
}
const { activePage = 'work' } = Astro.props;
const currentPath = Astro.url?.pathname ?? '/';
---

<header class="site-header">
  <nav class="nav-left">
    <a href="/" class:list={['nav-pill', { active: activePage === 'work' }]}>Work</a>
    <a href="/about" class:list={['nav-pill', { active: activePage === 'about' }]}>About</a>
  </nav>
  <div class="nav-center">
    <a href="/" class="site-name">Jacky Grob</a>
  </div>
  <div class="nav-right">
    <a href="mailto:hi@jackygrob.com" class="nav-email">hi@jackygrob.com</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    padding: 0.625rem 1rem;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-stroke);
    backdrop-filter: blur(8px);
    background-color: rgba(255, 255, 255, 0.95);
  }

  .nav-left {
    display: flex;
    gap: 0.375rem;
    align-items: center;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.875rem;
    border: 1.5px solid var(--color-black);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.2;
    transition: background-color 0.2s, color 0.2s;
  }

  .nav-pill:hover {
    background-color: var(--color-black);
    color: var(--color-white);
  }

  .nav-pill.active {
    background-color: var(--color-black);
    color: var(--color-white);
    border-color: var(--color-black);
  }

  .nav-center {
    text-align: center;
  }

  .site-name {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
  }

  .nav-right {
    text-align: right;
  }

  .nav-email {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    border: 1.5px solid var(--color-black);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.875rem;
    transition: background-color 0.2s, color 0.2s;
  }

  .nav-email:hover {
    background-color: var(--color-black);
    color: var(--color-white);
  }

  @media (max-width: 640px) {
    .site-header {
      grid-template-columns: auto 1fr auto;
      gap: 0.5rem;
    }
    .nav-center {
      display: none;
    }
    .site-header {
      grid-template-columns: auto auto;
    }
    .nav-right {
      display: none;
    }
  }
</style>
