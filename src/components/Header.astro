---
import { studio } from '../data/studio';
import PixelArt from './PixelArt.astro';

interface Props {
  activePage?: 'work' | 'about' | 'services' | 'blog' | 'none';
}
const { activePage = 'work' } = Astro.props;

const links = [
  { href: '/', label: 'Work', key: 'work' },
  { href: '/services', label: 'Services', key: 'services' },
  { href: '/about', label: 'About', key: 'about' },
  { href: '/blog', label: 'Blog', key: 'blog' },
] as const;

const mailto = `mailto:${studio.email}`;
const startMailto = `mailto:${studio.email}?subject=${encodeURIComponent('New project')}`;
---

<header class="site-header" data-header>
  <div class="bar">
    <a href="/" class="cell brand" aria-label={`${studio.name} — home`}>
      <PixelArt name="logo" scale={3} />
      <span class="brand-name">Salinash</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['cell', 'nav-link', { active: activePage === l.key }]}
          aria-current={activePage === l.key ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href={mailto} class="cell action">Get in touch</a>
      <a href={startMailto} class="cell action action-start">
        Start a project
        <PixelArt name="chev" scale={2} class="chev" />
      </a>
    </div>

    <button
      class="cell menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="menu-label">Menu</span>
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    {links.map((l) => (
      <a
        href={l.href}
        class:list={['mobile-link', { active: activePage === l.key }]}
        aria-current={activePage === l.key ? 'page' : undefined}
      >
        {l.label}
        <PixelArt name="chev" scale={2} class="chev" />
      </a>
    ))}
    <div class="mobile-actions">
      <a href={mailto} class="btn">Get in touch</a>
      <a href={startMailto} class="btn btn-light">
        Start a project
        <PixelArt name="chev" scale={2} class="chev" />
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: stretch;
    height: var(--nav-h);
  }

  .cell {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 1.375rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    color: var(--fg);
    white-space: nowrap;
    transition: background-color 0.2s, color 0.2s;
  }

  .cell:hover {
    background-color: var(--bg-hover);
  }

  .brand {
    min-width: var(--gutter);
    border-right: 1px solid var(--line);
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
  }

  .primary-nav {
    display: flex;
  }

  .nav-link {
    position: relative;
    border-right: 1px solid var(--line);
    color: var(--fg-soft);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--fg);
  }

  /* Active page: a short pixel bar sitting on the header rule */
  .nav-link.active::after {
    content: "";
    position: absolute;
    left: 1.375rem;
    bottom: -1px;
    width: 12px;
    height: 3px;
    background-color: var(--px-orange);
  }

  .nav-actions {
    display: flex;
    margin-left: auto;
  }

  .action {
    border-left: 1px solid var(--line);
  }

  .action-start :global(.chev) {
    transition: transform 0.2s;
  }

  .action-start:hover :global(.chev) {
    transform: translateX(3px);
  }

  /* Mobile */
  .menu-toggle {
    display: none;
    margin-left: auto;
    border: none;
    border-left: 1px solid var(--line);
    background: none;
    cursor: pointer;
  }

  .menu-icon {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
  }

  .menu-icon i {
    display: block;
    width: 16px;
    height: 2px;
    background-color: currentColor;
    transition: transform 0.2s;
  }

  .menu-toggle[aria-expanded="true"] .menu-icon i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-icon i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    border-top: 1px solid var(--line);
    background-color: var(--bg);
    height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--fg-soft);
  }

  .mobile-link.active {
    color: var(--fg);
  }

  .mobile-link.active :global(.chev) {
    color: var(--px-orange);
  }

  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 1rem;
  }

  .mobile-actions :global(.btn) {
    justify-content: space-between;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 1100px) {
    .cell {
      padding: 0 1rem;
    }

    .nav-link.active::after {
      left: 1rem;
    }

    .action:not(.action-start) {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .primary-nav,
    .nav-actions {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .brand {
      min-width: 0;
    }
  }
</style>
