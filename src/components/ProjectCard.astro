---
import ProjectVisual from './ProjectVisual.astro';
import type { VisualVariant } from '../data/studio';

interface Props {
  title: string;
  subtitle?: string;
  type: string;
  context: string;
  date: string;
  status?: string;
  summary?: string;
  visual: VisualVariant;
  href?: string;
}

const { title, subtitle, type, context, date, status, summary, visual, href = '#' } = Astro.props;
---

<a href={href} class="project-card" aria-label={`Read the ${title} case study`}>
  <span class="corner corner-tl" aria-hidden="true"></span>
  <span class="corner corner-tr" aria-hidden="true"></span>
  <span class="corner corner-bl" aria-hidden="true"></span>
  <span class="corner corner-br" aria-hidden="true"></span>

  <div class="card-inner">
    <div class="card-image-wrapper">
      <ProjectVisual variant={visual} class="card-visual" />
      <span class="card-title-badge">{title}</span>
      {status && <span class="card-status-badge">{status}</span>}
    </div>

    <div class="card-details">
      <div class="details-inner">
        <span class="details-heading">{title}</span>
        {summary && <p class="details-summary">{summary}</p>}
        <ul class="details-list">
          <li>
            <span class="detail-label">Type</span>
            <span class="detail-value">{type}</span>
          </li>
          <li>
            <span class="detail-label">Context</span>
            <span class="detail-value">{context}</span>
          </li>
          <li>
            <span class="detail-label">Date</span>
            <span class="detail-value">{date}</span>
          </li>
        </ul>
        <span class="details-cta">Read case study →</span>
      </div>
    </div>
  </div>

  <div class="card-caption">
    <span class="caption-title">{subtitle ?? type}</span>
    <span class="caption-date">{date}</span>
  </div>
</a>

<style>
  .project-card {
    display: block;
    position: relative;
    border: 1px solid var(--color-stroke);
    background-color: var(--color-white);
    cursor: pointer;
    transition: border-color 0.25s;
    text-decoration: none;
    color: inherit;
  }

  .project-card:hover {
    border-color: rgba(0, 0, 0, 0.3);
  }

  /* Corner square decorations */
  .corner {
    position: absolute;
    width: 5px;
    height: 5px;
    background-color: var(--color-black);
    z-index: 4;
    pointer-events: none;
  }

  .corner-tl { top: -3px; left: -3px; }
  .corner-tr { top: -3px; right: -3px; }
  .corner-bl { bottom: -3px; left: -3px; }
  .corner-br { bottom: -3px; right: -3px; }

  /* Main content area */
  .card-inner {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  /* Visual layer (above details) */
  .card-image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-color: var(--color-gray-50);
    clip-path: inset(0 0 0% 0);
    transform: translateY(0);
    transition:
      clip-path 0.52s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.52s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card-image-wrapper :global(.card-visual) {
    width: 100%;
    height: 100%;
  }

  /* Title badge floating over the visual — always visible */
  .card-title-badge {
    position: absolute;
    top: 0.625rem;
    left: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 400;
    background-color: var(--color-white);
    border: 1.5px solid var(--color-black);
    border-radius: var(--radius-pill);
    padding: 0.2rem 0.625rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: calc(100% - 1.25rem);
    z-index: 3;
  }

  .card-status-badge {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background-color: var(--color-black);
    color: var(--color-white);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.625rem;
    white-space: nowrap;
    z-index: 3;
  }

  /* Details panel (below visual layer) */
  .card-details {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--color-white);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
  }

  .details-inner {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transform: translateY(0.75rem);
    opacity: 0;
    transition:
      transform 0.38s 0.14s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.38s 0.14s ease;
  }

  .details-heading {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-black);
  }

  .details-summary {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-gray-700);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .details-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .details-list li {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    position: relative;
    padding-left: 1rem;
    line-height: 1.4;
  }

  .details-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-gray-700);
  }

  .detail-label {
    color: var(--color-gray-700);
  }

  .detail-value {
    color: var(--color-black);
  }

  .details-cta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-black);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Caption strip under the card */
  .card-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--color-stroke);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .caption-title {
    color: var(--color-black);
  }

  .caption-date {
    color: var(--color-gray-700);
    white-space: nowrap;
  }

  /* Hover — visual slides up, details fade in */
  @media (pointer: fine) {
    .project-card:hover .card-image-wrapper {
      clip-path: inset(0 0 58% 0);
      transform: translateY(-4%);
    }

    .project-card:hover .details-inner {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>
