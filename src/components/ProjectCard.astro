---
import ProjectVisual from './ProjectVisual.astro';
import PixelArt from './PixelArt.astro';
import type { VisualVariant } from '../data/studio';
import { projectIcon } from '../data/pixels';

interface Props {
  slug: string;
  number?: string;
  title: string;
  subtitle?: string;
  type: string;
  context: string;
  date: string;
  status?: string;
  summary?: string;
  visual: VisualVariant;
  href?: string;
}

const {
  slug,
  number,
  title,
  subtitle,
  type,
  context,
  date,
  status,
  summary,
  visual,
  href = '#',
} = Astro.props;

const icon = projectIcon[slug] ?? 'chip';
---

<a href={href} class="project-card" aria-label={`Read the ${title} case study`}>
  <div class="card-inner">
    <div class="card-image-wrapper">
      <ProjectVisual variant={visual} class="card-visual" />
      <span class="card-title-badge">
        <PixelArt name={icon} scale={2} />
        {title}
      </span>
      {status && <span class="card-status-badge">{status}</span>}
    </div>

    <div class="card-details">
      <div class="details-inner">
        <span class="details-heading">{title}</span>
        {summary && <p class="details-summary">{summary}</p>}
        <ul class="details-list">
          <li>
            <span class="detail-label">Type</span>
            <span class="detail-value">{type}</span>
          </li>
          <li>
            <span class="detail-label">Context</span>
            <span class="detail-value">{context}</span>
          </li>
          <li>
            <span class="detail-label">Date</span>
            <span class="detail-value">{date}</span>
          </li>
        </ul>
        <span class="details-cta">
          Read case study
          <PixelArt name="chev" scale={2} class="chev" />
        </span>
      </div>
    </div>
  </div>

  <div class="card-caption">
    <span class="caption-title">
      {number && <span class="caption-number">{number}</span>}
      {subtitle ?? type}
    </span>
    <span class="caption-date">{date}</span>
  </div>
</a>

<style>
  .project-card {
    display: block;
    position: relative;
    background-color: var(--bg);
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  /* Main content area */
  .card-inner {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  /* Visual layer (above details) */
  .card-image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-color: var(--bg-raised);
    clip-path: inset(0 0 0% 0);
    transform: translateY(0);
    transition:
      clip-path 0.52s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.52s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card-image-wrapper :global(.card-visual) {
    width: 100%;
    height: 100%;
  }

  /* Title tag floating over the visual — always visible */
  .card-title-badge {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    background-color: var(--bg);
    border: 1px solid var(--line-strong);
    padding: 0.4rem 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: calc(100% - 1.75rem);
    z-index: 3;
  }

  .card-status-badge {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: var(--px-amber);
    color: var(--bg);
    padding: 0.4rem 0.625rem;
    white-space: nowrap;
    z-index: 3;
  }

  /* Details panel (below visual layer) */
  .card-details {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
  }

  .details-inner {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    transform: translateY(0.75rem);
    opacity: 0;
    transition:
      transform 0.38s 0.14s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.38s 0.14s ease;
  }

  .details-heading {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .details-summary {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.55;
    color: var(--muted);
    max-width: 60ch;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .details-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    list-style: none;
  }

  .details-list li {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  .detail-label {
    color: var(--dim);
  }

  .detail-value {
    color: var(--fg-soft);
  }

  .details-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg);
  }

  /* Caption strip under the card */
  .card-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.875rem 1rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .caption-title {
    color: var(--fg-soft);
  }

  .caption-number {
    color: var(--dim);
    margin-right: 0.75rem;
  }

  .caption-date {
    color: var(--muted);
    white-space: nowrap;
  }

  /* Hover — visual slides up, details fade in */
  @media (pointer: fine) {
    .project-card:hover .card-image-wrapper {
      clip-path: inset(0 0 56% 0);
      transform: translateY(-4%);
    }

    .project-card:hover .details-inner {
      transform: translateY(0);
      opacity: 1;
    }

    .project-card:hover .details-cta :global(.chev) {
      transform: translateX(3px);
    }
  }

  .details-cta :global(.chev) {
    transition: transform 0.2s;
  }

  @media (max-width: 700px) {
    .card-title-badge {
      top: 0.625rem;
      left: 0.625rem;
      gap: 0.4rem;
      padding: 0.3rem 0.55rem;
      font-size: 0.8125rem;
    }

    .card-status-badge {
      top: 0.625rem;
      right: 0.625rem;
      padding: 0.3rem 0.5rem;
      font-size: 0.5625rem;
    }
  }
</style>
