---
/**
 * Project artwork: a pixel mosaic in the project's colour with an animated mock-up of the
 * product on top, in the same idiom as the capability panels on the home page.
 *
 * The mock-ups live on a 3:2 "stage" sized in container units (cqw), so they scale with
 * whatever holds them. `fit="slice"` fills the box (cards); `fit="meet"` centres the 3:2
 * stage inside a wider band and lets the mosaic run to the edges (case study covers).
 * Mock-ups are illustrations of each product, not screenshots.
 */
import PixelArt from './PixelArt.astro';
import PixelGrid from './PixelGrid.astro';
import type { VisualVariant } from '../data/studio';

interface Props {
  variant: VisualVariant;
  class?: string;
  fit?: 'slice' | 'meet';
}

const { variant, class: className = '', fit = 'slice' } = Astro.props;

const palettes: Record<VisualVariant, string[]> = {
  motion: ['#ff7a1a', '#ff8f3a', '#ff6a0d', '#ffa45c', '#f25a07'],
  imaging: ['#7dbcfb', '#a8d2ff', '#4a9ff2', '#cfe6ff', '#2d8ff0'],
  geometry: ['#ffd34d', '#ffc21a', '#ffe17a', '#ffb800', '#ffcf33'],
  landscape: ['#6fd5a8', '#8fe3bf', '#4fc490', '#b5efd5', '#3eb67e'],
  portfolio: ['#ff5a3c', '#ff6e4f', '#f2462a', '#ff8a6e', '#e63b1f'],
  assessment: ['#bfe3ff', '#a6d6ff', '#d9efff', '#8cc8f5', '#b3dcfc'],
  audio: ['#b5efd5', '#a0e8c7', '#c8f4e0', '#8de0b9', '#d6f7e8'],
  platform: ['#ffb31a', '#ffa200', '#ffc04d', '#ff9500', '#ffbb33'],
};

const seeds: Record<VisualVariant, number> = {
  motion: 5,
  imaging: 13,
  geometry: 29,
  landscape: 37,
  portfolio: 43,
  assessment: 59,
  audio: 67,
  platform: 71,
};

const walkFrames = [
  { sprite: 'walkStand', n: '01', flip: false },
  { sprite: 'walkStep', n: '08', flip: false },
  { sprite: 'walkStand', n: '16', flip: false },
  { sprite: 'walkStep', n: '24', flip: true },
] as const;

const phones = [
  { icon: 'chart', rows: ['#ffd21f', '#ff8103', '#3eb67e'] },
  { icon: 'rocket', rows: ['#a8d2ff', '#ff5228', '#ffaf02'] },
  { icon: 'bolt', rows: ['#8de0b9', '#ffd21f', '#037de3'] },
] as const;

/* GameTestPrep puzzle: size steps down each column, colour changes each row. */
const puzzle = [
  ['#ffaf02', 64], ['#ffaf02', 44], ['#ffaf02', 26],
  ['#ff5228', 64], ['#ff5228', 44], ['#ff5228', 26],
  ['#037de3', 64], ['#037de3', 44], null,
] as const;

const waveBars = [3, 6, 9, 5, 12, 8, 4, 10, 14, 7, 5, 11, 6, 13, 9, 4, 8, 12, 5, 10, 7, 3, 9, 6, 11, 4, 8, 13, 6, 9, 5, 7];
const requestBars = [5, 6, 5, 7, 8, 7, 9, 8, 10, 9, 11, 10, 9, 11, 12, 11, 13, 12, 14, 13];
---

<div class:list={['pv', `pv-${variant}`, `pv-${fit}`, className]} aria-hidden="true" data-reveal-hook>
  <PixelGrid colors={palettes[variant]} seed={seeds[variant]} cols={18} rows={12} class="pv-bg" />

  <div class="pv-stage">
    {variant === 'motion' && (
      <div class="pv-win mo-win" style="--e:0">
        <div class="pv-bar">
          <span class="pv-dots"><i></i><i></i><i></i></span>
          <span>npcmotion · generate</span>
          <span class="pv-live"><i></i>GPU warm</span>
        </div>
        <div class="mo-prompt">
          <span class="mo-sigil">&gt;</span> zombie shuffles forward, arms out<span class="pv-cursor"></span>
        </div>
        <div class="mo-body">
          <div class="mo-strip">
            {walkFrames.map((f, k) => (
              <div class="mo-frame" style={`--k:${k}`}>
                <PixelArt name={f.sprite} scale={4} class={f.flip ? 'flip' : undefined} />
                <span>f{f.n}</span>
              </div>
            ))}
          </div>
          <div class="mo-preview">
            <span class="mo-walker">
              <PixelArt name="walkStand" scale={6} class="w-stand" />
              <PixelArt name="walkStep" scale={6} class="w-step" />
              <PixelArt name="walkStep" scale={6} class="w-flip flip" />
            </span>
            <span class="mo-ground"></span>
            <span class="mo-label">preview</span>
          </div>
        </div>
        <div class="mo-foot">
          <span class="pv-tag">HY-Motion</span>
          <span class="pv-tag">Kimodo</span>
          <span class="pv-tag pv-tag-ok">R15 rig ✓</span>
        </div>
      </div>
    )}

    {variant === 'imaging' && (
      <>
        <div class="pv-win im-win" style="--e:0">
          <div class="pv-bar">
            <span class="pv-dots"><i></i><i></i><i></i></span>
            <span>DICOM Viewer Pro</span>
            <span class="pv-right">Axial</span>
          </div>
          <div class="im-body">
            <div class="im-series">
              {[0, 1, 2, 3].map((k) => (
                <span class="im-thumb" style={`--k:${k}`}><PixelArt name="scan" scale={2} /></span>
              ))}
            </div>
            <div class="im-view">
              <PixelArt name="scan" scale={8} class="im-scan" />
              <i class="im-cross-h"></i>
              <i class="im-cross-v"></i>
              <i class="im-sweep"></i>
              <span class="im-ov im-tl">Series 2</span>
              <span class="im-ov im-br">W / L</span>
            </div>
            <div class="im-wl"><i></i></div>
          </div>
        </div>
        <span class="pv-tag pv-float im-tag" style="--e:2">Metal pipeline</span>
      </>
    )}

    {variant === 'geometry' && (
      <div class="pv-win ge-win" style="--e:0">
        <div class="pv-bar">
          <span class="pv-dots"><i></i><i></i><i></i></span>
          <span>ConvertPoly</span>
          <span class="pv-right">scene.fbx</span>
        </div>
        <div class="ge-body">
          <div class="ge-view">
            <span class="ge-floor"></span>
            <span class="ge-shadow"></span>
            <PixelArt name="cube" scale={10} class="ge-cube" />
            <span class="im-ov im-tl">WebGL</span>
          </div>
          <div class="ge-side">
            <span class="ge-label">Export as</span>
            {['OBJ', 'FBX', 'glTF', 'STL'].map((f, k) => (
              <span class="ge-fmt" style={`--k:${k}`}>{f}</span>
            ))}
            <span class="ge-convert">
              Convert
              <PixelArt name="chev" scale={1} class="chev" />
            </span>
          </div>
        </div>
      </div>
    )}

    {variant === 'landscape' && (
      <>
        <div class="pv-win la-win" style="--e:0">
          <div class="pv-bar">
            <span class="pv-dots"><i></i><i></i><i></i></span>
            <span>garden plan</span>
            <span class="pv-right">AI layout</span>
          </div>
          <div class="la-plot"><PixelArt name="garden" scale={8} class="la-garden" /></div>
        </div>
        <div class="pv-card la-stamp" style="--e:2">
          <PixelArt name="trophy" scale={4} />
          <span class="la-stamp-text">
            <strong>Acquired</strong>
            <small>via Acquire.com</small>
          </span>
        </div>
        <div class="pv-card la-users" style="--e:3">
          <strong data-count>4,000</strong>
          <span>users reached</span>
        </div>
      </>
    )}

    {variant === 'portfolio' && (
      <>
        {phones.map((p, k) => (
          <div class="pf-phone" style={`--k:${k};--e:${k}`}>
            <div class="pf-screen">
              <div class="pf-head">
                <span class="pf-icon"><PixelArt name={p.icon} scale={2} /></span>
                <i></i>
              </div>
              {p.rows.map((c) => (
                <span class="pf-row"><b style={`background-color:${c}`}></b><i></i></span>
              ))}
              <span class="pf-cta"></span>
            </div>
          </div>
        ))}
        <div class="pv-card pf-card" style="--e:3">
          <strong data-count>£50K+</strong>
          <span>revenue · six apps</span>
          <div class="pf-bars">
            {[3, 4, 4, 6, 7, 9, 10, 12].map((h, k) => (
              <i style={`--h:${h};--k:${k}`}></i>
            ))}
          </div>
        </div>
      </>
    )}

    {variant === 'assessment' && (
      <>
        <div class="pv-win as-win" style="--e:0">
          <div class="pv-bar">
            <span class="pv-dots"><i></i><i></i><i></i></span>
            <span>GameTestPrep</span>
            <span class="pv-right">Level 4</span>
          </div>
          <div class="as-timer"><i></i></div>
          <div class="as-grid">
            {puzzle.map((cell) =>
              cell ? (
                <span class="as-cell">
                  <b style={`background-color:${cell[0]};width:${cell[1]}%;height:${cell[1]}%`}></b>
                </span>
              ) : (
                <span class="as-cell as-slot">?</span>
              )
            )}
          </div>
          <div class="as-foot">
            <span class="pv-tag">Pattern recognition</span>
            <span class="as-btn">Submit</span>
          </div>
        </div>
        <div class="pv-card as-users" style="--e:2">
          <strong data-count>500</strong>
          <span>users</span>
        </div>
      </>
    )}

    {variant === 'audio' && (
      <>
        <div class="pv-win au-win" style="--e:0">
          <div class="pv-bar">
            <span class="pv-dots"><i></i><i></i><i></i></span>
            <span>transcribe</span>
            <span class="pv-live pv-live-red"><i></i>Live</span>
          </div>
          <div class="au-wave">
            {waveBars.map((h, k) => (
              <i style={`--h:${h};--k:${k}`}></i>
            ))}
            <span class="au-head"></span>
          </div>
          <div class="au-lines">
            <p><span class="au-time">00:42</span> we should revisit <mark>pricing</mark> before launch</p>
            <p><span class="au-time">00:47</span> the <mark style="--k:1">cost</mark> question came up again</p>
            <p><span class="au-time">00:53</span> agreed, let’s<span class="pv-cursor"></span></p>
          </div>
        </div>
        <div class="pv-card au-search" style="--e:2">
          <span class="au-q">Search by meaning</span>
          <strong>“pricing worries”</strong>
          <span class="au-hit">00:42</span>
          <span class="au-hit">00:47</span>
        </div>
      </>
    )}

    {variant === 'platform' && (
      <>
        <div class="pv-win pl-win" style="--e:0">
          <div class="pv-bar">
            <span class="pv-dots"><i></i><i></i><i></i></span>
            <span>inventory · production</span>
            <span class="pv-live"><i></i>healthy</span>
          </div>
          <div class="pl-body">
            <div class="pl-panel">
              <span class="pl-label">Pods</span>
              <div class="pl-pods">
                {Array.from({ length: 12 }, (_, k) => (
                  <i style={`--k:${k}`}></i>
                ))}
              </div>
            </div>
            <div class="pl-panel">
              <span class="pl-label">Requests</span>
              <div class="pl-bars">
                {requestBars.map((h, k) => (
                  <i style={`--h:${h};--k:${k}`}></i>
                ))}
              </div>
            </div>
            <div class="pl-pipe">
              {['build', 'test', 'deploy'].map((step, k) => (
                <>
                  {k > 0 && <PixelArt name="chev" scale={1} class="chev" />}
                  <span class="pl-step" style={`--k:${k}`}>{step}</span>
                </>
              ))}
            </div>
          </div>
        </div>
        <div class="pv-card pl-deploy" style="--e:2">
          <strong data-count>−70%</strong>
          <span>deploy time</span>
        </div>
      </>
    )}
  </div>
</div>

<style>
  .pv {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    font-family: var(--font-mono);
    color: var(--fg);
  }

  .pv :global(.pv-bg) {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .pv-stage {
    position: absolute;
    container-type: inline-size;
  }

  .pv-slice .pv-stage {
    inset: 0;
  }

  .pv-meet .pv-stage {
    top: 0;
    bottom: 0;
    left: 50%;
    height: 100%;
    aspect-ratio: 3 / 2;
    max-width: 100%;
    transform: translateX(-50%);
  }

  .pv :global(.flip) {
    transform: scaleX(-1);
  }

  /* ---------- Shared chrome ---------- */
  .pv-win,
  .pv-card,
  .pv-float,
  .pf-phone {
    position: absolute;
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--e, 0) * 120ms + 100ms);
  }

  :global(html.js-motion) .pv:not(.is-in) :is(.pv-win, .pv-card, .pv-float, .pf-phone) {
    opacity: 0;
    transform: translateY(4cqw);
  }

  .pv-win {
    background-color: #121214;
    border-radius: 1cqw;
    box-shadow: 0 2.5cqw 5cqw rgba(0, 0, 0, 0.3);
    overflow: hidden;
  }

  .pv-bar {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    padding: 1.2cqw 1.8cqw;
    border-bottom: 1px solid #26262b;
    font-size: clamp(7px, 1.6cqw, 12px);
    color: var(--muted);
    white-space: nowrap;
  }

  .pv-dots {
    display: inline-flex;
    gap: 0.6cqw;
  }

  .pv-dots i {
    width: 0.9cqw;
    height: 0.9cqw;
    background-color: var(--px-green);
  }

  .pv-dots i:first-child {
    background-color: var(--px-red);
  }

  .pv-dots i:nth-child(2) {
    background-color: var(--px-amber);
  }

  .pv-right,
  .pv-live {
    margin-left: auto;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .pv-live {
    display: inline-flex;
    align-items: center;
    gap: 0.7cqw;
    color: var(--px-mint);
  }

  .pv-live i {
    width: 0.9cqw;
    height: 0.9cqw;
    background-color: var(--px-green);
    animation: px-blink 1.4s steps(1) infinite;
  }

  .pv-live-red {
    color: #ff8f7a;
  }

  .pv-live-red i {
    background-color: var(--px-red);
  }

  .pv-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.7cqw 1.2cqw;
    background-color: #1b1b1f;
    border: 1px solid #2c2c32;
    font-size: clamp(7px, 1.45cqw, 11px);
    color: var(--fg-soft);
    white-space: nowrap;
  }

  .pv-tag-ok {
    color: var(--px-mint);
  }

  .pv-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.15em;
    vertical-align: -0.15em;
    background-color: var(--px-orange);
    animation: px-blink 1s steps(1) infinite;
  }

  .pv-card {
    display: flex;
    flex-direction: column;
    gap: 0.6cqw;
    padding: 2cqw 2.2cqw;
    background-color: #121214;
    border-radius: 1cqw;
    box-shadow: 0 2.5cqw 5cqw rgba(0, 0, 0, 0.3);
    font-size: clamp(7px, 1.45cqw, 11px);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .pv-card strong {
    font-family: var(--font-sans);
    font-size: clamp(14px, 4.4cqw, 34px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: none;
    color: var(--fg);
  }

  .im-ov {
    position: absolute;
    font-size: clamp(6px, 1.3cqw, 10px);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--px-sky);
  }

  .im-tl {
    top: 1.2cqw;
    left: 1.4cqw;
  }

  .im-br {
    right: 1.4cqw;
    bottom: 1.2cqw;
  }

  /* ---------- NPCMotion ---------- */
  .mo-win {
    left: 7%;
    top: 15%;
    width: 86%;
  }

  .mo-prompt {
    padding: 1.8cqw 2cqw 0;
    font-size: clamp(8px, 1.9cqw, 14px);
    color: var(--fg);
    white-space: nowrap;
  }

  .mo-sigil {
    color: var(--px-orange);
  }

  .mo-body {
    display: flex;
    gap: 1.6cqw;
    padding: 1.8cqw 2cqw;
  }

  .mo-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1cqw;
    flex: 1;
  }

  .mo-frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 1cqw;
    padding: 2cqw 0 1cqw;
    background-color: #18181b;
    border: 1px solid #2a2a30;
    font-size: clamp(6px, 1.25cqw, 10px);
    color: var(--dim);
    animation: mo-active 2.4s steps(1) infinite;
    animation-delay: calc(var(--k) * 0.6s);
  }

  .mo-frame :global(svg) {
    width: 45%;
    height: auto;
  }

  @keyframes mo-active {
    0% { border-color: var(--px-orange); color: var(--px-orange); }
    25%, 100% { border-color: #2a2a30; color: var(--dim); }
  }

  .mo-preview {
    position: relative;
    width: 24cqw;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 3.4cqw;
    background-color: #0b0b0d;
    border: 1px solid #2a2a30;
  }

  .mo-walker {
    position: relative;
    display: block;
    width: 8cqw;
    aspect-ratio: 9 / 12;
  }

  .mo-walker :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: auto;
  }

  .mo-walker :global(.w-stand) { animation: w-stand 1.2s linear infinite; }
  .mo-walker :global(.w-step) { animation: w-step 1.2s linear infinite; }
  .mo-walker :global(.w-flip) { animation: w-flip 1.2s linear infinite; }

  @keyframes w-stand {
    0%, 24.9% { opacity: 1; }
    25%, 49.9% { opacity: 0; }
    50%, 74.9% { opacity: 1; }
    75%, 100% { opacity: 0; }
  }

  @keyframes w-step {
    0%, 24.9% { opacity: 0; }
    25%, 49.9% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @keyframes w-flip {
    0%, 74.9% { opacity: 0; }
    75%, 100% { opacity: 1; }
  }

  .mo-ground {
    width: 70%;
    height: 2px;
    margin-top: 0.4cqw;
    background: repeating-linear-gradient(90deg, #3a3a42 0 4px, transparent 4px 8px);
    animation: ground 0.6s linear infinite;
  }

  @keyframes ground {
    to { background-position: -8px 0; }
  }

  .mo-label {
    position: absolute;
    left: 1.2cqw;
    top: 1cqw;
    font-size: clamp(6px, 1.2cqw, 9px);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dim);
  }

  .mo-foot {
    display: flex;
    gap: 1cqw;
    padding: 0 2cqw 2cqw;
  }

  /* ---------- DICOM Viewer Pro ---------- */
  .im-win {
    left: 7%;
    top: 13%;
    width: 86%;
  }

  .im-body {
    display: grid;
    grid-template-columns: 9cqw 1fr 2.4cqw;
    gap: 1.6cqw;
    padding: 1.8cqw;
  }

  .im-series {
    display: flex;
    flex-direction: column;
    gap: 1cqw;
  }

  .im-thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background-color: #000;
    border: 1px solid #26262b;
    animation: im-thumb 4s steps(1) infinite;
    animation-delay: calc(var(--k) * 1s);
  }

  .im-thumb :global(svg) {
    width: 70%;
    height: auto;
  }

  @keyframes im-thumb {
    0% { border-color: var(--px-sky); }
    25%, 100% { border-color: #26262b; }
  }

  .im-view {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background-color: #000;
    overflow: hidden;
  }

  .im-view :global(.im-scan) {
    width: auto;
    height: 86%;
  }

  .im-cross-h,
  .im-cross-v {
    position: absolute;
    background-color: rgba(168, 210, 255, 0.45);
  }

  .im-cross-h {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    animation: im-cross-y 6s ease-in-out infinite;
  }

  .im-cross-v {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    animation: im-cross-x 7s ease-in-out infinite;
  }

  @keyframes im-cross-y {
    0%, 100% { top: 42%; }
    50% { top: 60%; }
  }

  @keyframes im-cross-x {
    0%, 100% { left: 56%; }
    50% { left: 40%; }
  }

  .im-sweep {
    position: absolute;
    left: 0;
    right: 0;
    top: -20%;
    height: 18%;
    background: linear-gradient(180deg, transparent, rgba(3, 125, 227, 0.28), transparent);
    animation: im-sweep 3.2s linear infinite;
  }

  @keyframes im-sweep {
    to { top: 110%; }
  }

  .im-wl {
    position: relative;
    background-color: #1d1d22;
  }

  .im-wl i {
    position: absolute;
    left: 0;
    right: 0;
    height: 14%;
    background-color: var(--px-sky);
    animation: im-wl 5s ease-in-out infinite;
  }

  @keyframes im-wl {
    0%, 100% { top: 18%; }
    50% { top: 62%; }
  }

  .im-tag {
    right: 5%;
    bottom: 6%;
  }

