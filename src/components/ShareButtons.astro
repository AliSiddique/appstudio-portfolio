---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="share-section">
  <span class="share-label">/ SHARE</span>
  <div class="share-buttons">
    <a id="share-x" href="#" target="_blank" rel="noopener" class="share-btn">X</a>
    <a id="share-linkedin" href="#" target="_blank" rel="noopener" class="share-btn">LinkedIn</a>
    <a id="share-reddit" href="#" target="_blank" rel="noopener" class="share-btn">Reddit</a>
    <button id="share-copy" class="share-btn" data-title={title}>Copy link</button>
  </div>
</div>

<script>
  const url = encodeURIComponent(window.location.href);
  const copyBtn = document.getElementById('share-copy') as HTMLButtonElement;
  const title = encodeURIComponent(copyBtn?.dataset.title ?? '');

  (document.getElementById('share-x') as HTMLAnchorElement).href =
    `https://x.com/intent/tweet?text=${title}&url=${url}`;

  (document.getElementById('share-linkedin') as HTMLAnchorElement).href =
    `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;

  (document.getElementById('share-reddit') as HTMLAnchorElement).href =
    `https://reddit.com/submit?url=${url}&title=${title}`;

  copyBtn?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(window.location.href);
    copyBtn.textContent = 'Copied!';
    setTimeout(() => { copyBtn.textContent = 'Copy link'; }, 2000);
  });
</script>

<style>
  .share-section {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 2.5rem;
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-stroke);
    flex-wrap: wrap;
  }

  .share-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
    white-space: nowrap;
  }

  .share-buttons {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.875rem;
    border: 1.5px solid var(--color-black);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.2;
    background: none;
    cursor: pointer;
    text-decoration: none;
    color: var(--color-black);
    transition: background-color 0.2s, color 0.2s;
  }

  .share-btn:hover {
    background-color: var(--color-black);
    color: var(--color-white);
  }
</style>
