---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="share-section">
  <span class="eyebrow">/ Share</span>
  <div class="share-buttons">
    <a id="share-x" href="#" target="_blank" rel="noopener" class="share-btn">X</a>
    <a id="share-linkedin" href="#" target="_blank" rel="noopener" class="share-btn">LinkedIn</a>
    <a id="share-reddit" href="#" target="_blank" rel="noopener" class="share-btn">Reddit</a>
    <button id="share-copy" class="share-btn" type="button" data-title={title}>Copy link</button>
  </div>
</div>

<script>
  const url = encodeURIComponent(window.location.href);
  const copyBtn = document.getElementById('share-copy') as HTMLButtonElement;
  const title = encodeURIComponent(copyBtn?.dataset.title ?? '');

  (document.getElementById('share-x') as HTMLAnchorElement).href =
    `https://x.com/intent/tweet?text=${title}&url=${url}`;

  (document.getElementById('share-linkedin') as HTMLAnchorElement).href =
    `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;

  (document.getElementById('share-reddit') as HTMLAnchorElement).href =
    `https://reddit.com/submit?url=${url}&title=${title}`;

  copyBtn?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(window.location.href);
    copyBtn.textContent = 'Copied!';
    setTimeout(() => {
      copyBtn.textContent = 'Copy link';
    }, 2000);
  });
</script>

<style>
  .share-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background-color: var(--bg-card);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--fg);
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .share-btn:hover {
    background-color: var(--bg-hover);
    border-color: var(--px-orange);
  }
</style>
