---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  type: string;
  context: string;
  date: string;
  role: string;
  number?: string;
  metaDescription?: string;
  nextProject?: { title: string; href: string };
}

const {
  title,
  type,
  context,
  date,
  role,
  number = '001',
  metaDescription,
  nextProject,
} = Astro.props;
---

<Layout title={`${title} — Jacky Grob`} description={metaDescription}>
  <Header />

  <!-- Back nav bar -->
  <div class="project-back-bar">
    <a href="/" class="back-link">← Work</a>
    <span class="project-index">/ {number}</span>
  </div>

  <!-- Project hero -->
  <section class="project-hero">
    <h1 class="project-title">{title}</h1>
    <div class="project-meta-bar">
      <div class="meta-col">
        <span class="meta-label">Type</span>
        <span class="meta-value">{type}</span>
      </div>
      <div class="meta-col">
        <span class="meta-label">Context</span>
        <span class="meta-value">{context}</span>
      </div>
      <div class="meta-col">
        <span class="meta-label">Date</span>
        <span class="meta-value">{date}</span>
      </div>
      <div class="meta-col">
        <span class="meta-label">Role</span>
        <span class="meta-value">{role}</span>
      </div>
    </div>
  </section>

  <!-- Page content from child -->
  <slot />

  <!-- Next project -->
  {nextProject && (
    <section class="next-project-section">
      <a href={nextProject.href} class="next-project-link">
        <span class="next-label">/ Next Project</span>
        <span class="next-title">{nextProject.title}</span>
        <span class="next-arrow">→</span>
      </a>
    </section>
  )}

  <Footer />
</Layout>

<style>
  /* Back nav */
  .project-back-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--color-stroke);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-black);
    border: 1.5px solid var(--color-black);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    transition: background-color 0.2s, color 0.2s;
  }

  .back-link:hover {
    background-color: var(--color-black);
    color: var(--color-white);
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
  }

  /* Hero */
  .project-hero {
    padding: 3rem 1.25rem 0;
    border-bottom: 1px solid var(--color-stroke);
  }

  .project-title {
    font-family: var(--font-sans);
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 2.5rem;
  }

  .project-meta-bar {
    display: flex;
    border-top: 1px solid var(--color-stroke);
  }

  .meta-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.875rem 1rem;
    border-right: 1px solid var(--color-stroke);
  }

  .meta-col:last-child {
    border-right: none;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
  }

  .meta-value {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-black);
  }

  /* Next project */
  .next-project-section {
    border-top: 1px solid var(--color-stroke);
  }

  .next-project-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 1.25rem;
    transition: background-color 0.25s, color 0.25s;
    text-decoration: none;
    color: inherit;
    gap: 1rem;
  }

  .next-project-link:hover {
    background-color: var(--color-black);
    color: var(--color-white);
  }

  .next-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.5;
    white-space: nowrap;
  }

  .next-title {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1;
  }

  .next-arrow {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1;
    flex-shrink: 0;
  }

  /* Shared project content styles (applied globally for slot content) */
  :global(.project-cover) {
    border-bottom: 1px solid var(--color-stroke);
  }

  :global(.cover-img-wrap) {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-gray-100);
  }

  :global(.cover-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.project-overview) {
    border-bottom: 1px solid var(--color-stroke);
  }

  :global(.overview-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  :global(.overview-left) {
    padding: 2.5rem 1.5rem;
    border-right: 1px solid var(--color-stroke);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(.overview-right) {
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  :global(.section-label) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
    margin-bottom: 0.5rem;
  }

  :global(.overview-text) {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-black);
  }

  :global(.detail-block) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.detail-block-label) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
  }

  :global(.detail-list) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  :global(.detail-list li) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-black);
    position: relative;
    padding-left: 1rem;
    line-height: 1.6;
  }

  :global(.detail-list li::before) {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-gray-700);
  }

  :global(.project-gallery) {
    border-bottom: 1px solid var(--color-stroke);
  }

  :global(.gallery-label) {
    padding: 1.25rem 1.5rem 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
    border-bottom: 1px solid var(--color-stroke);
    padding-bottom: 1.25rem;
  }

  :global(.gallery-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  :global(.gallery-item) {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-gray-100);
    border-right: 1px solid var(--color-stroke);
    border-bottom: 1px solid var(--color-stroke);
  }

  :global(.gallery-item:nth-child(even)) {
    border-right: none;
  }

  :global(.gallery-item:nth-last-child(-n+2)) {
    border-bottom: none;
  }

  :global(.gallery-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  :global(.gallery-item:hover .gallery-img) {
    transform: scale(1.03);
  }

  @media (max-width: 768px) {
    :global(.overview-grid) {
      grid-template-columns: 1fr;
    }

    :global(.overview-left) {
      border-right: none;
      border-bottom: 1px solid var(--color-stroke);
    }

    :global(.gallery-grid) {
      grid-template-columns: 1fr;
    }

    :global(.gallery-item) {
      border-right: none;
      border-bottom: 1px solid var(--color-stroke);
    }

    :global(.gallery-item:last-child) {
      border-bottom: none;
    }
  }

  @media (max-width: 640px) {
    .project-meta-bar {
      flex-wrap: wrap;
    }

    .meta-col {
      flex: 1 1 45%;
    }

    .meta-col:nth-child(2) {
      border-right: none;
    }

    .meta-col:nth-child(1),
    .meta-col:nth-child(2) {
      border-bottom: 1px solid var(--color-stroke);
    }
  }
</style>
