---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  subtitle?: string;
  type: string;
  context: string;
  date: string;
  role: string;
  status?: string;
  headline?: string;
  results?: { value: string; label: string }[];
  number?: string;
  metaDescription?: string;
  nextProject?: { title: string; href: string };
}

const {
  title,
  subtitle,
  type,
  context,
  date,
  role,
  status,
  headline,
  results = [],
  number = '001',
  metaDescription,
  nextProject,
} = Astro.props;
---

<Layout title={`${title} — Ali Siddique`} description={metaDescription} ogType="website">
  <Header />

  <!-- Back nav bar -->
  <div class="project-back-bar">
    <a href="/" class="back-link">← Work</a>
    <span class="project-index">/ {number}</span>
  </div>

  <!-- Project hero -->
  <section class="project-hero">
    {status && <span class="project-status">{status}</span>}
    <h1 class="project-title">{title}</h1>
    {subtitle && <p class="project-subtitle">{subtitle}</p>}
    {headline && <p class="project-headline">{headline}</p>}
    <div class="project-meta-bar">
      <div class="meta-col">
        <span class="meta-label">Type</span>
        <span class="meta-value">{type}</span>
      </div>
      <div class="meta-col">
        <span class="meta-label">Context</span>
        <span class="meta-value">{context}</span>
      </div>
      <div class="meta-col">
        <span class="meta-label">Date</span>
        <span class="meta-value">{date}</span>
      </div>
      <div class="meta-col">
        <span class="meta-label">Role</span>
        <span class="meta-value">{role}</span>
      </div>
    </div>
  </section>

  {results.length > 0 && (
    <section class="results-band">
      <span class="results-label">/ Outcomes</span>
      <div class="results-grid">
        {results.map((r) => (
          <div class="result-cell">
            <span class="result-value">{r.value}</span>
            <span class="result-label">{r.label}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Page content from child -->
  <slot />

  <!-- Next project -->
  {nextProject && (
    <section class="next-project-section">
      <a href={nextProject.href} class="next-project-link">
        <span class="next-label">/ Next Project</span>
        <span class="next-title">{nextProject.title}</span>
        <span class="next-arrow">→</span>
      </a>
    </section>
  )}

  <Footer />
</Layout>

<style>
  /* Back nav */
  .project-back-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--color-stroke);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-black);
    border: 1.5px solid var(--color-black);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    transition: background-color 0.2s, color 0.2s;
  }

  .back-link:hover {
    background-color: var(--color-black);
    color: var(--color-white);
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
  }

  /* Hero */
  .project-hero {
    padding: 3rem 1.25rem 0;
    border-bottom: 1px solid var(--color-stroke);
  }

  .project-status {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background-color: var(--color-black);
    color: var(--color-white);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    margin-bottom: 1rem;
  }

  .project-title {
    font-family: var(--font-sans);
    font-size: clamp(2.5rem, 8vw, 6.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .project-subtitle {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
    margin-top: 0.875rem;
  }

  .project-headline {
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 2.4vw, 1.875rem);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-black);
    max-width: 44ch;
    margin-top: 1.75rem;
  }

  /* Results band */
  .results-band {
    background-color: var(--color-dark);
    color: var(--color-white);
    padding: 2.5rem 1.25rem;
  }

  .results-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
    margin-bottom: 1.75rem;
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .result-cell {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 1.25rem 0 0;
    border-right: 1px solid rgba(255, 255, 255, 0.14);
  }

  .result-cell:last-child {
    border-right: none;
  }

  .result-cell:not(:first-child) {
    padding-left: 1.25rem;
  }

  .result-value {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .result-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
    line-height: 1.5;
  }

  .project-meta-bar {
    display: flex;
    border-top: 1px solid var(--color-stroke);
    margin-top: 2.5rem;
  }

  .meta-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.875rem 1rem;
    border-right: 1px solid var(--color-stroke);
  }

  .meta-col:last-child {
    border-right: none;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
  }

  .meta-value {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-black);
  }

  /* Next project */
  .next-project-section {
    border-top: 1px solid var(--color-stroke);
  }

  .next-project-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 1.25rem;
    transition: background-color 0.25s, color 0.25s;
    text-decoration: none;
    color: inherit;
    gap: 1rem;
  }

  .next-project-link:hover {
    background-color: var(--color-black);
    color: var(--color-white);
  }

  .next-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.5;
    white-space: nowrap;
  }

  .next-title {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1;
  }

  .next-arrow {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1;
    flex-shrink: 0;
  }

  /* Shared project content styles (applied globally for slot content) */
  :global(.project-cover) {
    border-bottom: 1px solid var(--color-stroke);
  }

  :global(.cover-img-wrap) {
    height: clamp(230px, 34vw, 520px);
    overflow: hidden;
    background-color: var(--color-gray-50);
  }

  :global(.cover-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.project-overview) {
    border-bottom: 1px solid var(--color-stroke);
  }

  :global(.overview-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  :global(.overview-left) {
    padding: 2.5rem 1.5rem;
    border-right: 1px solid var(--color-stroke);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(.overview-right) {
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  :global(.section-label) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
    margin-bottom: 0.5rem;
  }

  :global(.overview-text) {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-black);
  }

  :global(.detail-block) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.detail-block-label) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
  }

  :global(.detail-list) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  :global(.detail-list li) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-black);
    position: relative;
    padding-left: 1rem;
    line-height: 1.6;
  }

  :global(.detail-list li::before) {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-gray-700);
  }

  /* Case study body — challenge, approach, stack */
  :global(.case-section) {
    padding: 4rem 1.25rem;
    border-bottom: 1px solid var(--color-stroke);
  }

  :global(.case-section-gray) {
    background-color: var(--color-gray-50);
  }

  :global(.case-header) {
    max-width: 800px;
    margin-bottom: 2.5rem;
  }

  :global(.case-heading) {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-top: 0.75rem;
  }

  :global(.case-body) {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    max-width: 68ch;
  }

  :global(.case-body p) {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-gray-700);
  }

  :global(.approach-grid) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--color-stroke);
    background-color: var(--color-white);
  }

  :global(.approach-card) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.75rem 1.5rem;
    border-right: 1px solid var(--color-stroke);
    border-bottom: 1px solid var(--color-stroke);
  }

  :global(.approach-card:nth-child(even)) {
    border-right: none;
  }

  :global(.approach-card:nth-last-child(-n + 2):nth-child(odd)),
  :global(.approach-card:last-child) {
    border-bottom: none;
  }

  :global(.approach-number) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
  }

  :global(.approach-title) {
    font-family: var(--font-sans);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.25;
  }

  :global(.approach-body) {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-gray-700);
  }

  :global(.case-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  :global(.case-chip) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    border: 1px solid var(--color-stroke);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    background-color: var(--color-white);
    white-space: nowrap;
  }

  :global(.project-gallery) {
    border-bottom: 1px solid var(--color-stroke);
  }

  :global(.gallery-label) {
    padding: 1.25rem 1.5rem 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
    border-bottom: 1px solid var(--color-stroke);
    padding-bottom: 1.25rem;
  }

  :global(.gallery-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  :global(.gallery-item) {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-gray-100);
    border-right: 1px solid var(--color-stroke);
    border-bottom: 1px solid var(--color-stroke);
  }

  :global(.gallery-item:nth-child(even)) {
    border-right: none;
  }

  :global(.gallery-item:nth-last-child(-n+2)) {
    border-bottom: none;
  }

  :global(.gallery-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  :global(.gallery-item:hover .gallery-img) {
    transform: scale(1.03);
  }

  @media (max-width: 768px) {
    :global(.approach-grid) {
      grid-template-columns: 1fr;
    }

    :global(.approach-card),
    :global(.approach-card:nth-child(even)) {
      border-right: none;
      border-bottom: 1px solid var(--color-stroke);
    }

    :global(.approach-card:last-child) {
      border-bottom: none;
    }

    :global(.overview-grid) {
      grid-template-columns: 1fr;
    }

    :global(.overview-left) {
      border-right: none;
      border-bottom: 1px solid var(--color-stroke);
    }

    :global(.gallery-grid) {
      grid-template-columns: 1fr;
    }

    :global(.gallery-item) {
      border-right: none;
      border-bottom: 1px solid var(--color-stroke);
    }

    :global(.gallery-item:last-child) {
      border-bottom: none;
    }
  }

  @media (max-width: 640px) {
    .project-meta-bar {
      flex-wrap: wrap;
    }

    .meta-col {
      flex: 1 1 45%;
    }

    .meta-col:nth-child(2) {
      border-right: none;
    }

    .meta-col:nth-child(1),
    .meta-col:nth-child(2) {
      border-bottom: 1px solid var(--color-stroke);
    }
  }
</style>
