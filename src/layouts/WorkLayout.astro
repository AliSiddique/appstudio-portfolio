---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PixelArt from '../components/PixelArt.astro';
import { projectIcon } from '../data/pixels';

interface Props {
  slug?: string;
  title: string;
  subtitle?: string;
  type: string;
  context: string;
  date: string;
  role: string;
  status?: string;
  headline?: string;
  results?: { value: string; label: string }[];
  number?: string;
  metaDescription?: string;
  nextProject?: { title: string; href: string };
}

const {
  slug,
  title,
  subtitle,
  type,
  context,
  date,
  role,
  status,
  headline,
  results = [],
  number = '001',
  metaDescription,
  nextProject,
} = Astro.props;

const icon = slug ? projectIcon[slug] : undefined;
const nextIcon = nextProject ? projectIcon[nextProject.href.split('/').pop() ?? ''] : undefined;

/* Only values that start with a number (optionally after a symbol) count up — "R15" and
   "Metal" stay as they are. */
const countable = (value: string) => /^[^A-Za-z\d]*\d/.test(value);

const meta = [
  { label: 'Type', value: type },
  { label: 'Context', value: context },
  { label: 'Date', value: date },
  { label: 'Role', value: role },
];
---

<Layout title={`${title} — Salinash Studio`} description={metaDescription} ogType="website">
  <Header activePage="work" />

  <main>
    <!-- Back bar -->
    <div class="back-bar">
      <a href="/#work" class="back-link">
        <PixelArt name="chev" scale={2} class="chev chev-back" />
        Work
      </a>
      <span class="back-meta">Case study / {number}</span>
    </div>

    <!-- Hero -->
    <section class="project-hero">
      <div class="project-kicker" data-reveal>
        {icon && <PixelArt name={icon} scale={6} />}
        {status && <span class="project-status">{status}</span>}
      </div>
      <h1 class="project-title" data-reveal="wipe">{title}</h1>
      <div class="project-intro">
        {subtitle && <p class="project-subtitle" data-reveal>{subtitle}</p>}
        {headline && (
          <p class="project-headline" data-reveal style="--delay:200ms">
            {headline}
          </p>
        )}
      </div>
    </section>

    <dl class="meta-bar" data-reveal-stagger="80">
      {meta.map((m) => (
        <div class="meta-cell">
          <dt>{m.label}</dt>
          <dd>{m.value}</dd>
        </div>
      ))}
    </dl>

    {results.length > 0 && (
      <section class="results-band" aria-label="Outcomes">
        <span class="results-label" data-reveal>/ Outcomes</span>
        <div class="results-grid" data-reveal-stagger="100">
          {results.map((r) => (
            <div class="result-cell">
              <span class="result-value" data-count={countable(r.value) ? '' : undefined}>{r.value}</span>
              <span class="result-label">{r.label}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <slot />

    {nextProject && (
      <section class="next-project" aria-label="Next project">
        <a href={nextProject.href} class="next-link" data-reveal>
          <span class="eyebrow next-eyebrow">/ Next project</span>
          <span class="next-row">
            {nextIcon && <PixelArt name={nextIcon} scale={6} class="next-icon" />}
            <span class="next-title">{nextProject.title}</span>
            <span class="next-arrow"><PixelArt name="arrow" scale={6} /></span>
          </span>
        </a>
      </section>
    )}
  </main>

  <Footer />
</Layout>

<style>
  /* Back bar */
  .back-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem clamp(1.25rem, 3.5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .back-link:hover {
    background-color: var(--bg-hover);
    border-color: #4a4a52;
  }

  .back-link :global(.chev-back) {
    transform: rotate(180deg);
  }

  .back-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  /* Hero */
  .project-hero {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: clamp(3rem, 6vw, 5.5rem) clamp(1.25rem, 3.5vw, 3.5rem) clamp(2.5rem, 4vw, 3.5rem);
  }

  .project-kicker {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .project-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: var(--px-amber);
    color: var(--bg);
    padding: 0.45rem 0.7rem;
  }

  .project-title {
    font-size: clamp(3.25rem, 11vw, 11rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .project-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
    gap: 1.5rem 3rem;
    align-items: start;
  }

  .project-subtitle {
    padding-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .project-headline {
    grid-column: 2;
    max-width: 34ch;
    font-size: clamp(1.5rem, 2.8vw, 2.625rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  /* Meta bar */
  .meta-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .meta-cell {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem clamp(1.25rem, 3.5vw, 3.5rem) 1.5rem;
    border-right: 1px solid var(--line);
  }

  .meta-cell:last-child {
    border-right: none;
  }

  .meta-cell dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .meta-cell dd {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  /* Results band */
  .results-band {
    background-color: var(--px-crimson);
    color: #ffffff;
    padding: 2.5rem clamp(1.25rem, 3.5vw, 3.5rem) 3rem;
  }

  .results-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 1.75rem;
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.28);
  }

  .result-cell {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem 1.5rem 0 0;
    border-right: 1px solid rgba(255, 255, 255, 0.28);
  }

  .result-cell:last-child {
    border-right: none;
  }

  .result-cell:not(:first-child) {
    padding-left: 1.5rem;
  }

  .result-value {
    font-size: clamp(2.5rem, 5.4vw, 5.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .result-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Next project */
  .next-project {
    border-top: 1px solid var(--line);
  }

  .next-link {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 3.5vw, 3.5rem);
    transition: background-color 0.25s, color 0.25s;
  }

  .next-row {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .next-title {
    flex: 1;
    font-size: clamp(2.5rem, 7.5vw, 7.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .next-arrow {
    display: inline-flex;
    transition: transform 0.25s;
  }

  .next-link:hover {
    background-color: var(--px-orange);
    color: var(--bg);
  }

  .next-link:hover .next-eyebrow {
    color: var(--bg);
  }

  .next-link:hover .next-arrow {
    transform: translateX(8px);
  }

  @media (max-width: 900px) {
    .project-intro {
      grid-template-columns: 1fr;
    }

    .project-headline {
      grid-column: 1;
    }

    .meta-bar {
      grid-template-columns: repeat(2, 1fr);
    }

    .meta-cell:nth-child(2n) {
      border-right: none;
    }

    .meta-cell:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 640px) {
    .results-grid {
      grid-template-columns: 1fr;
    }

    .result-cell,
    .result-cell:not(:first-child) {
      padding: 1.5rem 0;
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.28);
    }

    .result-cell:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .next-row :global(.next-icon) {
      display: none;
    }

    .next-arrow :global(svg) {
      width: 28px;
      height: auto;
    }
  }
</style>
