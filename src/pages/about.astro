---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PixelArt from '../components/PixelArt.astro';
import SectionHead from '../components/sections/SectionHead.astro';
import NumbersGrid from '../components/sections/NumbersGrid.astro';
import StackList from '../components/sections/StackList.astro';
import { studio, timeline, credentials } from '../data/studio';
import type { SpriteName } from '../data/pixels';

const startMailto = `mailto:${studio.email}?subject=${encodeURIComponent('New project')}`;

const profile: { label: string; items: string[] }[] = [
  {
    label: 'Currently',
    items: [
      'ML inference infrastructure',
      'Serverless GPU pipelines',
      'iOS & Metal rendering',
      '3D geometry processing',
      'Real-time web interfaces',
    ],
  },
  {
    label: 'Core stack',
    items: [
      'TypeScript / React',
      'Swift / SwiftUI / Metal',
      'Elixir / Phoenix',
      'Python / Modal',
      'Go / Kubernetes / AWS',
    ],
  },
  {
    label: 'Approach',
    items: [
      'Architecture first',
      'Own the whole stack',
      'Ship and measure',
      'Observable by default',
      'Boring deploys',
    ],
  },
  {
    label: 'Also',
    items: ['Art', 'Music & guitar', 'CS tutoring', 'Open source'],
  },
];

const credentialIcon: Record<string, SpriteName> = {
  Certification: 'cloud',
  Education: 'chart',
  Recognition: 'trophy',
  Coursework: 'chip',
};
---

<Layout
  title="About — Salinash Studio | Ali Siddique"
  description={`${studio.name} is led by ${studio.principal}, a full-stack and product engineer — ML infrastructure, iOS and graphics, and cloud platform engineering.`}
  ogType="website"
>
  <Header activePage="about" />

  <main>
    <!-- Hero -->
    <section class="page-hero">
      <SectionHead
        eyebrow={`/ About — ${studio.name}, est. ${studio.founded}`}
        align="left"
        as="h1"
        size="xl"
      >
        Built end to end, from the GPU up.
        <Fragment slot="lede">
          {studio.name} is led by {studio.principal}, a full-stack and product engineer with 3+
          years designing, building and operating production software end to end — from system
          architecture and infrastructure through to launch and growth. Recent work spans ML
          inference on serverless GPUs, GPU rendering with Metal, 3D geometry processing and
          real-time interfaces in TypeScript and React.
        </Fragment>
        <Fragment slot="actions">
          <a href={startMailto} class="btn btn-light">
            Start a project
            <PixelArt name="chev" scale={2} class="chev" />
          </a>
          <a href="/services" class="link-chev">
            Services
            <PixelArt name="chev" scale={2} class="chev" />
          </a>
        </Fragment>
      </SectionHead>

      <div class="hero-gutter" aria-hidden="true">
        <PixelArt name="satellite" scale={4} class="gutter-satellite" />
        <div class="gutter-stack">
          <span class="gutter-blk" style="--c:var(--px-yellow);--i:2">
            <PixelArt name="robot" scale={4} class="gutter-sprite" />
          </span>
          <span class="gutter-blk" style="--c:var(--px-orange);--i:1"></span>
          <span class="gutter-blk" style="--c:var(--px-crimson);--i:0"></span>
        </div>
      </div>
    </section>

    <!-- Profile -->
    <section class="profile" aria-label="Profile">
      <div class="profile-grid" data-reveal-stagger="90">
        {profile.map((col) => (
          <div class="profile-cell">
            <span class="eyebrow">/ {col.label}</span>
            <ul class="square-list">
              {col.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Numbers -->
    <section aria-labelledby="numbers-title">
      <SectionHead eyebrow="/ Track record" id="numbers-title">
        The track record,<br /> in numbers.
      </SectionHead>
      <NumbersGrid />
    </section>

    <!-- Skills -->
    <section class="ruled" aria-labelledby="skills-title">
      <SectionHead eyebrow="/ Technical skills" id="skills-title">
        The tools the work actually runs on.
        <Fragment slot="lede">
          Languages, frameworks and infrastructure used in production — not evaluated once.
        </Fragment>
      </SectionHead>
      <StackList />
    </section>

    <!-- CV -->
    <section class="ruled" aria-labelledby="cv-title">
      <SectionHead eyebrow="/ Experience" id="cv-title" align="left" size="xl">C.V.</SectionHead>
      <div class="cv-table" data-reveal-stagger="70">
        {timeline.map((entry) => (
          <div class="cv-row">
            <span class="cv-period">{entry.period}</span>
            <div class="cv-entries">
              {entry.entries.map((e) => (
                <div class="cv-entry">
                  <h3 class="cv-company">{e.company}</h3>
                  <div class="cv-role-block">
                    <span class="cv-role">{e.role}</span>
                    {e.detail && <p class="cv-detail">{e.detail}</p>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Credentials -->
    <section aria-labelledby="credentials-title">
      <SectionHead eyebrow="/ Certifications & education" id="credentials-title">
        Credentials.
      </SectionHead>
      <div class="credentials-grid" data-reveal-stagger="90">
        {credentials.map((c) => (
          <div class="credential-cell">
            <PixelArt name={credentialIcon[c.label] ?? 'chip'} scale={4} />
            <span class="eyebrow">/ {c.label}</span>
            <h3 class="credential-title">{c.title}</h3>
            <p class="credential-detail">{c.detail}</p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .page-hero {
    display: grid;
    grid-template-columns: 1fr var(--gutter);
    min-height: clamp(520px, 72svh, 780px);
  }

  .page-hero > :global(.section-head) {
    justify-content: flex-end;
  }

  .hero-gutter {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-left: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-gutter :global(.gutter-satellite) {
    position: absolute;
    top: 2rem;
    left: 50%;
    width: clamp(36px, 48%, 68px);
    height: auto;
    translate: -50% 0;
    animation: page-bob 4.5s ease-in-out infinite;
  }

  .gutter-stack {
    display: flex;
    flex-direction: column;
  }

  .gutter-blk {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background-color: var(--c);
    animation: page-drop 1s cubic-bezier(0.55, 0, 0.45, 1) both;
    animation-delay: calc(var(--i) * 0.14s + 0.2s);
  }

  .gutter-blk :global(.gutter-sprite) {
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: clamp(28px, 40%, 56px);
    height: auto;
    translate: -50% 0;
    z-index: 1;
  }

  @keyframes page-drop {
    0% { transform: translateY(-120vh); }
    72% { transform: translateY(0); }
    84% { transform: translateY(-7%); }
    100% { transform: translateY(0); }
  }

  @keyframes page-bob {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(10px) rotate(3deg); }
  }

  /* ---------- Profile ---------- */
  .profile {
    border-bottom: 1px solid var(--line);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .profile-cell {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem clamp(1.25rem, 2.5vw, 2.25rem) 2.5rem;
    border-right: 1px solid var(--line);
  }

  .profile-cell:last-child {
    border-right: none;
  }

  .square-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .square-list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .square-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    background-color: var(--px-orange);
  }

  /* ---------- Shared rules ---------- */
  .ruled {
    border-bottom: 1px solid var(--line);
  }

  /* ---------- CV ---------- */
  .cv-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    padding: 1.75rem clamp(1.25rem, 3.5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  .cv-row:last-child {
    border-bottom: none;
  }

  .cv-period {
    padding-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--px-amber);
  }

  .cv-entries {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cv-entry {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 1.5rem;
    align-items: start;
  }

  .cv-company {
    font-size: clamp(1.375rem, 2.2vw, 2rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .cv-role-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.35rem;
  }

  .cv-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-soft);
  }

  .cv-detail {
    max-width: 62ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- Credentials ---------- */
  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .credential-cell {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 2.25rem clamp(1.25rem, 2.5vw, 2.25rem) 2.75rem;
    border-right: 1px solid var(--line);
  }

  .credential-cell:last-child {
    border-right: none;
  }

  .credential-cell :global(svg) {
    margin-bottom: 0.75rem;
  }

  .credential-title {
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .credential-detail {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    .profile-grid,
    .credentials-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .profile-cell:nth-child(2n),
    .credential-cell:nth-child(2n) {
      border-right: none;
    }

    .profile-cell:nth-child(-n + 2),
    .credential-cell:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }

    .cv-entry {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  @media (max-width: 700px) {
    .page-hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero-gutter {
      display: none;
    }

    .profile-grid,
    .credentials-grid {
      grid-template-columns: 1fr;
    }

    .profile-cell,
    .credential-cell,
    .profile-cell:nth-child(2n),
    .credential-cell:nth-child(2n) {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .profile-cell:last-child,
    .credential-cell:last-child {
      border-bottom: none;
    }

    .cv-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.5rem 1rem;
    }

    .cv-period {
      padding-top: 0;
    }
  }
</style>
