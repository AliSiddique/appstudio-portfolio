---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const cvEntries = [
  {
    period: "2024 - now",
    entries: [
      { company: "Salinash Studio", role: "Founder — iOS Apps, Monday.com Apps, Framer Templates, Shopify Apps" }
    ]
  },
  {
    period: "2023 - now",
    entries: [
      { company: "Self-employed", role: "Freelance Software & Cloud Engineering" }
    ]
  },
  {
    period: "2022 - 2023",
    entries: [
      { company: "Cloud Engineering", role: "AWS / Azure Infrastructure, DevOps, CI/CD Pipelines" }
    ]
  },
  {
    period: "2020 - 2022",
    entries: [
      { company: "Software Development", role: "Full-Stack Web Development, API Design" }
    ]
  }
];
---

<Layout
  title="About — Ali Siddique – Software & Cloud Engineer"
  description="Ali Siddique runs Salinash Studio, a software and cloud engineering practice building iOS apps, Monday.com integrations, Framer templates, job boards, and Shopify apps."
  ogType="website"
>
  <Header activePage="about" />

  <!-- About Hero -->
  <section class="about-hero">
    <h1 class="about-headline">
      Ali Siddique runs Salinash Studio — building iOS apps, Monday.com integrations, Framer templates, job boards, and Shopify apps. Grounded in cloud engineering, with a love for art, music, and guitar.
    </h1>
  </section>

  <!-- Info Grid -->
  <section class="info-section">
    <div class="info-grid">
      <div class="info-col">
        <span class="info-label">/ CURRENTLY</span>
        <div class="info-content">
          <p>iOS App Development</p>
          <p>Monday.com Apps</p>
          <p>Framer Templates</p>
          <p>Job Board Websites</p>
          <p>Shopify Apps</p>
        </div>
      </div>
      <div class="info-col">
        <span class="info-label">/ STACK</span>
        <div class="info-content">
          <p>Swift / SwiftUI</p>
          <p>AWS / Azure</p>
          <p>Node.js / TypeScript</p>
          <p>Framer</p>
          <p>Shopify</p>
        </div>
      </div>
      <div class="info-col">
        <span class="info-label">/ VALUES</span>
        <div class="info-content">
          <p>Collaboration</p>
          <p>Creativity</p>
          <p>Efficiency</p>
          <p>Cloud-native</p>
          <p>Purpose</p>
          <p>Trust</p>
        </div>
      </div>
      <div class="info-col">
        <span class="info-label">/ INTERESTS</span>
        <div class="info-content">
          <p>Art</p>
          <p>Music & Guitar</p>
          <p>Open Source</p>
          <p>Cloud Architecture</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CV Section -->
  <section class="cv-section">
    <h2 class="cv-title">C.V.</h2>
    <div class="cv-table">
      {cvEntries.map(entry => (
        <div class="cv-row">
          <div class="cv-period">{entry.period}</div>
          <div class="cv-entries">
            {entry.entries.map(e => (
              <div class="cv-entry">
                <span class="cv-company">{e.company}</span>
                <span class="cv-role">{e.role}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* About Hero */
  .about-hero {
    padding: 3rem 1.25rem 3.5rem;
    border-bottom: 1px solid var(--color-stroke);
  }

  .about-headline {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3.5vw, 3rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    max-width: 1100px;
  }

  /* Info Grid */
  .info-section {
    border-bottom: 1px solid var(--color-stroke);
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .info-col {
    padding: 1.75rem 1.25rem;
    border-right: 1px solid var(--color-stroke);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-col:last-child {
    border-right: none;
  }

  .info-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
  }

  .info-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .info-content p {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--color-black);
  }

  .info-link {
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s;
  }

  .info-link:hover {
    opacity: 0.6;
  }

  /* CV Section */
  .cv-section {
    padding: 3rem 1.25rem 4rem;
  }

  .cv-title {
    font-family: var(--font-sans);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    margin-bottom: 2rem;
  }

  .cv-table {
    border-top: 1px solid var(--color-stroke);
  }

  .cv-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    border-bottom: 1px solid var(--color-stroke);
    padding: 1.25rem 0;
    align-items: start;
  }

  .cv-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
    padding-top: 0.125rem;
  }

  .cv-entries {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cv-entry {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .cv-company {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-black);
  }

  .cv-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .info-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .info-col:nth-child(2) {
      border-right: none;
    }

    .info-col:nth-child(1),
    .info-col:nth-child(2) {
      border-bottom: 1px solid var(--color-stroke);
    }
  }

  @media (max-width: 640px) {
    .info-grid {
      grid-template-columns: 1fr;
    }

    .info-col {
      border-right: none;
      border-bottom: 1px solid var(--color-stroke);
    }

    .cv-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .cv-entry {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
