---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { studio, metrics, outcomes, stack, timeline, credentials } from '../data/studio';
---

<Layout
  title="About — Salinash Studio | Ali Siddique"
  description={`${studio.principal} is a full-stack and product engineer running ${studio.name} in ${studio.location} — ML infrastructure, iOS and graphics, and cloud platform engineering.`}
  ogType="website"
>
  <Header activePage="about" />

  <!-- About Hero -->
  <section class="about-hero">
    <span class="hero-tag">/ {studio.name} — Est. {studio.founded}, {studio.location}</span>
    <h1 class="about-headline">
      {studio.principal} is a full-stack and product engineer with 3+ years designing, building and
      operating production software end to end — from system architecture and infrastructure through
      to launch and growth.
    </h1>
    <p class="about-sub">
      Recent work spans ML inference infrastructure serving motion-generation models on serverless
      GPUs, GPU rendering with Metal, 3D geometry processing, and real-time interfaces in TypeScript
      and React. One AI product built and sold via Acquire.com. Six iOS apps shipped. AWS Certified
      Solutions Architect.
    </p>
  </section>

  <!-- Info Grid -->
  <section class="info-section">
    <div class="info-grid">
      <div class="info-col">
        <span class="info-label">/ CURRENTLY</span>
        <div class="info-content">
          <p>ML Inference Infrastructure</p>
          <p>Serverless GPU Pipelines</p>
          <p>iOS & Metal Rendering</p>
          <p>3D Geometry Processing</p>
          <p>Real-Time Web Interfaces</p>
        </div>
      </div>
      <div class="info-col">
        <span class="info-label">/ CORE STACK</span>
        <div class="info-content">
          <p>TypeScript / React</p>
          <p>Swift / SwiftUI / Metal</p>
          <p>Elixir / Phoenix</p>
          <p>Python / Modal</p>
          <p>Go / Kubernetes / AWS</p>
        </div>
      </div>
      <div class="info-col">
        <span class="info-label">/ APPROACH</span>
        <div class="info-content">
          <p>Architecture First</p>
          <p>Own The Whole Stack</p>
          <p>Ship And Measure</p>
          <p>Observable By Default</p>
          <p>Boring Deploys</p>
        </div>
      </div>
      <div class="info-col">
        <span class="info-label">/ ALSO</span>
        <div class="info-content">
          <p>Art</p>
          <p>Music & Guitar</p>
          <p>CS Tutoring</p>
          <p>Open Source</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Numbers -->
  <section class="numbers-section">
    <span class="numbers-label">/ Track record</span>
    <div class="numbers-grid">
      {metrics.map(m => (
        <div class="number-cell">
          <span class="number-value">{m.value}</span>
          <span class="number-label">{m.label}</span>
          <span class="number-detail">{m.detail}</span>
        </div>
      ))}
    </div>
    <div class="numbers-secondary">
      {outcomes.map(o => (
        <div class="secondary-cell">
          <span class="secondary-value">{o.value}</span>
          <span class="secondary-label">{o.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Technical skills -->
  <section class="skills-section">
    <div class="skills-header">
      <span class="section-tag">/ Technical skills</span>
      <h2 class="skills-headline">
        The tools the work actually runs on — languages, frameworks and infrastructure used in
        production, not evaluated once.
      </h2>
    </div>
    <div class="skills-table">
      {stack.map(group => (
        <div class="skills-row">
          <span class="skills-row-label">{group.label}</span>
          <div class="skills-chips">
            {group.items.map(item => (
              <span class="skills-chip">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CV Section -->
  <section class="cv-section">
    <h2 class="cv-title">C.V.</h2>
    <div class="cv-table">
      {timeline.map(entry => (
        <div class="cv-row">
          <div class="cv-period">{entry.period}</div>
          <div class="cv-entries">
            {entry.entries.map(e => (
              <div class="cv-entry">
                <span class="cv-company">{e.company}</span>
                <div class="cv-role-block">
                  <span class="cv-role">{e.role}</span>
                  {e.detail && <span class="cv-detail">{e.detail}</span>}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Credentials -->
  <section class="credentials-section">
    <span class="section-tag">/ Certifications & education</span>
    <div class="credentials-grid">
      {credentials.map(c => (
        <div class="credential-card">
          <span class="credential-label">{c.label}</span>
          <h3 class="credential-title">{c.title}</h3>
          <p class="credential-detail">{c.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Contact -->
  <section class="contact-section">
    <span class="section-tag">/ Direct</span>
    <div class="contact-grid">
      <a href={`mailto:${studio.email}`} class="contact-item">
        <span class="contact-item-label">Studio</span>
        <span class="contact-item-value">{studio.email}</span>
      </a>
      <a href={`tel:${studio.phoneHref}`} class="contact-item">
        <span class="contact-item-label">Phone</span>
        <span class="contact-item-value">{studio.phone}</span>
      </a>
      <a href={studio.github} target="_blank" rel="noopener" class="contact-item">
        <span class="contact-item-label">GitHub</span>
        <span class="contact-item-value">github.com/AliSiddique</span>
      </a>
      <a href={studio.linkedin} target="_blank" rel="noopener" class="contact-item">
        <span class="contact-item-label">LinkedIn</span>
        <span class="contact-item-value">in/alihsiddique</span>
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* About Hero */
  .about-hero {
    padding: 3rem 1.25rem 3.5rem;
    border-bottom: 1px solid var(--color-stroke);
  }

  .hero-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
    margin-bottom: 1.5rem;
  }

  .about-headline {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3.2vw, 2.75rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    max-width: 1100px;
  }

  .about-sub {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.7vw, 1.25rem);
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-gray-700);
    max-width: 780px;
    margin-top: 1.75rem;
  }

  /* Info Grid */
  .info-section {
    border-bottom: 1px solid var(--color-stroke);
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .info-col {
    padding: 1.75rem 1.25rem;
    border-right: 1px solid var(--color-stroke);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-col:last-child {
    border-right: none;
  }

  .info-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
  }

  .info-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .info-content p {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--color-black);
  }

  /* Numbers */
  .numbers-section {
    background-color: var(--color-dark);
    color: var(--color-white);
    padding: 3.5rem 1.25rem;
  }

  .numbers-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
    margin-bottom: 2rem;
  }

  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .number-cell {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.75rem 1.5rem 1.75rem 0;
    border-right: 1px solid rgba(255, 255, 255, 0.14);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .number-cell:not(:nth-child(3n + 1)) {
    padding-left: 1.5rem;
  }

  .number-cell:nth-child(3n) {
    border-right: none;
  }

  .number-value {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .number-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .number-detail {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-gray-700);
  }

  .numbers-secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    padding-top: 1.75rem;
  }

  .secondary-cell {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }

  .secondary-value {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .secondary-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
  }

  /* Skills */
  .skills-section {
    padding: 4rem 1.25rem;
    background-color: var(--color-gray-50);
    border-bottom: 1px solid var(--color-stroke);
  }

  .section-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
    margin-bottom: 0.75rem;
  }

  .skills-header {
    max-width: 800px;
    margin-bottom: 2.5rem;
  }

  .skills-headline {
    font-family: var(--font-sans);
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .skills-table {
    border-top: 1px solid var(--color-stroke);
  }

  .skills-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    align-items: start;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--color-stroke);
  }

  .skills-row-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
    padding-top: 0.3rem;
  }

  .skills-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skills-chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    border: 1px solid var(--color-stroke);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    background-color: var(--color-white);
    white-space: nowrap;
  }

  /* CV Section */
  .cv-section {
    padding: 3.5rem 1.25rem 4rem;
    border-bottom: 1px solid var(--color-stroke);
  }

  .cv-title {
    font-family: var(--font-sans);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    margin-bottom: 2rem;
  }

  .cv-table {
    border-top: 1px solid var(--color-stroke);
  }

  .cv-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    border-bottom: 1px solid var(--color-stroke);
    padding: 1.5rem 0;
    align-items: start;
  }

  .cv-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
    padding-top: 0.125rem;
  }

  .cv-entries {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cv-entry {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 1rem;
    align-items: start;
  }

  .cv-company {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-black);
    padding-top: 0.1rem;
  }

  .cv-role-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cv-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-black);
  }

  .cv-detail {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-gray-700);
    max-width: 62ch;
  }

  /* Credentials */
  .credentials-section {
    padding: 3.5rem 1.25rem 4rem;
    border-bottom: 1px solid var(--color-stroke);
  }

  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--color-stroke);
    margin-top: 1.5rem;
  }

  .credential-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 1.25rem;
    border-right: 1px solid var(--color-stroke);
  }

  .credential-card:last-child {
    border-right: none;
  }

  .credential-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
  }

  .credential-title {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .credential-detail {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-gray-700);
  }

  /* Contact */
  .contact-section {
    padding: 3.5rem 1.25rem 4rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--color-stroke);
    margin-top: 1.5rem;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.5rem 1.25rem 1.5rem 0;
    border-right: 1px solid var(--color-stroke);
    transition: opacity 0.2s;
  }

  .contact-item:not(:first-child) {
    padding-left: 1.25rem;
  }

  .contact-item:last-child {
    border-right: none;
  }

  .contact-item:hover {
    opacity: 0.6;
  }

  .contact-item-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-700);
  }

  .contact-item-value {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 3px;
    word-break: break-word;
  }

  /* Responsive */
  @media (max-width: 1080px) {
    .credentials-grid,
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .credential-card:nth-child(even),
    .contact-item:nth-child(even) {
      border-right: none;
    }

    .credential-card:nth-child(-n + 2),
    .contact-item:nth-child(-n + 2) {
      border-bottom: 1px solid var(--color-stroke);
    }

    .contact-item:nth-child(odd) {
      padding-left: 0;
    }

    .contact-item:nth-child(even) {
      padding-left: 1.25rem;
    }
  }

  @media (max-width: 900px) {
    .info-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .info-col:nth-child(2) {
      border-right: none;
    }

    .info-col:nth-child(1),
    .info-col:nth-child(2) {
      border-bottom: 1px solid var(--color-stroke);
    }

    .numbers-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .number-cell:nth-child(3n) {
      border-right: 1px solid rgba(255, 255, 255, 0.14);
    }

    .number-cell:nth-child(even) {
      border-right: none;
    }

    .number-cell:nth-child(odd) {
      padding-left: 0;
    }

    .number-cell:nth-child(even) {
      padding-left: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .info-grid {
      grid-template-columns: 1fr;
    }

    .info-col {
      border-right: none;
      border-bottom: 1px solid var(--color-stroke);
    }

    .numbers-grid {
      grid-template-columns: 1fr;
    }

    .number-cell,
    .number-cell:nth-child(even),
    .number-cell:nth-child(3n) {
      border-right: none;
      padding-left: 0;
    }

    .numbers-secondary {
      flex-direction: column;
      gap: 1rem;
    }

    .skills-row,
    .cv-row,
    .cv-entry {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .credentials-grid,
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .credential-card,
    .contact-item,
    .credential-card:nth-child(even),
    .contact-item:nth-child(even) {
      border-right: none;
      border-bottom: 1px solid var(--color-stroke);
      padding-left: 0;
    }

    .credential-card:last-child,
    .contact-item:last-child {
      border-bottom: none;
    }
  }
</style>
