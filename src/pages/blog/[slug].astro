---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import ShareButtons from '../../components/ShareButtons.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout
  title={`${post.data.title} — Ali Siddique`}
  description={post.data.description}
  ogType="article"
  publishedDate={post.data.date}
>
  <Header activePage="blog" />

  <article class="post-article">
    <header class="post-header">
      <div class="post-header-meta">
        <a href="/blog" class="back-link">← Blog</a>
        <span class="post-date">{post.data.date}</span>
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      {post.data.description && (
        <p class="post-description">{post.data.description}</p>
      )}
    </header>

    <div class="post-content">
      <Content />
    </div>

    <ShareButtons title={post.data.title} />
  </article>

  <Footer />
</Layout>

<style>
  .post-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.25rem 6rem;
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-stroke);
  }

  .post-header-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.6;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
  }

  .post-title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
  }

  .post-description {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-gray-700);
  }

  /* Markdown content styles — matching site aesthetic */
  .post-content {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-black);
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    font-family: var(--font-sans);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(h1) { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .post-content :global(h2) { font-size: clamp(1.375rem, 2.5vw, 1.875rem); }
  .post-content :global(h3) { font-size: 1.25rem; }
  .post-content :global(h4) { font-size: 1.0625rem; }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s;
  }

  .post-content :global(a:hover) {
    opacity: 0.6;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.375rem;
  }

  .post-content :global(blockquote) {
    border-left: 2px solid var(--color-stroke);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-gray-700);
    font-style: italic;
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--color-gray-50);
    border: 1px solid var(--color-stroke);
    padding: 0.125em 0.375em;
    border-radius: 3px;
  }

  .post-content :global(pre) {
    background-color: var(--color-gray-50);
    border: 1px solid var(--color-stroke);
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }

  .post-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.875rem;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-stroke);
    margin: 2.5rem 0;
  }

  .post-content :global(img) {
    max-width: 100%;
    border: 1px solid var(--color-stroke);
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid var(--color-stroke);
    padding: 0.625rem 0.875rem;
    text-align: left;
  }

  .post-content :global(th) {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background-color: var(--color-gray-50);
  }
</style>
