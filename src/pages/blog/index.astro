---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PixelArt from '../../components/PixelArt.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
---

<Layout
  title="Blog — Salinash Studio"
  description="Writing about ML infrastructure, GPU rendering, iOS engineering, cloud architecture, and whatever else is worth writing down."
  ogType="website"
>
  <Header activePage="blog" />

  <main>
    <section class="blog-head">
      <span class="eyebrow" data-reveal>/ Notes from the studio</span>
      <div class="blog-head-row">
        <h1 class="blog-title" data-reveal="wipe">Blog</h1>
        <p class="blog-sub" data-reveal style="--delay:200ms">
          Writing about ML infrastructure, GPU rendering, iOS engineering and cloud architecture —
          and whatever else is worth writing down.
          <span class="blog-count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
        </p>
      </div>
    </section>

    <section class="posts" aria-label="Posts" data-reveal-stagger="80">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="post-row">
          <span class="post-date">{post.data.date}</span>
          <div class="post-info">
            <h2 class="post-title">{post.data.title}</h2>
            {post.data.description && <p class="post-desc">{post.data.description}</p>}
          </div>
          <span class="post-arrow" aria-hidden="true"><PixelArt name="arrow" scale={4} /></span>
        </a>
      ))}
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .blog-head {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(3.5rem, 6vw, 5rem) clamp(1.25rem, 3.5vw, 3.5rem) 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .blog-head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .blog-title {
    font-size: clamp(3.25rem, 14vw, 15rem);
    font-weight: 500;
    line-height: 0.85;
    letter-spacing: -0.06em;
  }

  .blog-sub {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 40ch;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .blog-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--px-amber);
  }

  .posts {
    border-bottom: 1px solid var(--line);
  }

  .post-row {
    display: grid;
    grid-template-columns: 180px 1fr auto;
    gap: 2rem;
    align-items: center;
    padding: 2rem clamp(1.25rem, 3.5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.2s;
  }

  .post-row:last-child {
    border-bottom: none;
  }

  .post-row:hover {
    background-color: var(--bg-raised);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .post-info {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .post-title {
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .post-desc {
    max-width: 70ch;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .post-arrow {
    display: inline-flex;
    color: var(--muted);
    transition: transform 0.2s, color 0.2s;
  }

  .post-row:hover .post-arrow {
    color: var(--px-orange);
    transform: translateX(6px);
  }

  @media (max-width: 700px) {
    .post-row {
      grid-template-columns: 1fr auto;
      gap: 1rem;
      padding: 1.75rem 1rem;
    }

    .post-date {
      grid-column: 1 / -1;
    }
  }
</style>
