---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
---

<Layout
  title="Blog — Ali Siddique"
  description="Writing about cloud engineering, iOS development, Shopify, Framer, Monday.com, and whatever else is on my mind."
  ogType="website"
>
  <Header activePage="blog" />

  <section class="blog-title-section">
    <h1 class="blog-title">BLOG</h1>
  </section>

  <section class="posts-section">
    {posts.map(post => (
      <a href={`/blog/${post.slug}`} class="post-row">
        <div class="post-meta">
          <span class="post-date">{post.data.date}</span>
        </div>
        <div class="post-info">
          <h2 class="post-title">{post.data.title}</h2>
          {post.data.description && (
            <p class="post-desc">{post.data.description}</p>
          )}
        </div>
        <div class="post-arrow">→</div>
      </a>
    ))}
  </section>

  <Footer />
</Layout>

<style>
  .blog-title-section {
    padding: 1.5rem 0 0;
    overflow: hidden;
    border-bottom: 1px solid var(--color-stroke);
  }

  .blog-title {
    font-family: var(--font-sans);
    font-size: clamp(4rem, 14vw, 13rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    padding: 0 0.5rem;
  }

  .posts-section {
    border-bottom: 1px solid var(--color-stroke);
  }

  .post-row {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid var(--color-stroke);
    transition: background-color 0.15s;
    text-decoration: none;
  }

  .post-row:last-child {
    border-bottom: none;
  }

  .post-row:hover {
    background-color: var(--color-gray-50);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
  }

  .post-title {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-black);
    margin-bottom: 0.25rem;
  }

  .post-desc {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-gray-700);
    line-height: 1.4;
  }

  .post-arrow {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    color: var(--color-gray-700);
    transition: transform 0.15s;
  }

  .post-row:hover .post-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .post-row {
      grid-template-columns: 1fr auto;
      gap: 1rem;
    }

    .post-meta {
      grid-column: 1 / -1;
    }
  }
</style>
