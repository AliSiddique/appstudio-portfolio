---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PixelArt from '../components/PixelArt.astro';
import CapabilityVisual from '../components/CapabilityVisual.astro';
import {
  studio,
  metrics,
  outcomes,
  capabilities,
  process,
  stack,
  projects,
  credentials,
} from '../data/studio';
import { projectIcon, type SpriteName } from '../data/pixels';

const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
const startMailto = `mailto:${studio.email}?subject=${encodeURIComponent('New project')}`;

/* Giant scrolling band under the hero. */
const marquee: { label: string; icon: SpriteName }[] = [
  { label: 'ML inference', icon: 'chip' },
  { label: 'iOS apps', icon: 'phoneSm' },
  { label: 'Metal pipelines', icon: 'bolt' },
  { label: 'Real-time 3D', icon: 'cube' },
  { label: 'Cloud platforms', icon: 'cloud' },
  { label: 'Launch & growth', icon: 'rocket' },
  { label: 'Taken to exit', icon: 'trophy' },
];

/* The studio's fact sheet — every line comes from studio.ts. */
const facts: { label: string; value: string; href?: string }[] = [
  { label: 'Studio', value: studio.name },
  { label: 'Founded', value: String(studio.founded) },
  { label: 'Principal', value: `${studio.principal} — ${studio.role}` },
  { label: 'Practice', value: capabilities.map((c) => c.title).join(' · ') },
  {
    label: 'Track record',
    value: `1 exit via Acquire.com · ${projects.length} case studies · 6 iOS apps shipped`,
  },
  { label: 'Credentials', value: credentials.slice(0, 3).map((c) => c.title).join(' · ') },
  { label: 'Contact', value: studio.email, href: `mailto:${studio.email}` },
];
const ramp = ['#ffd21f', '#ffaf02', '#ff8103', '#ff5228', '#d3290f', '#ffaf02'];

/* "Strings" graph: lit nodes are the disciplines, dim ones the work underneath them. */
const strings: { label: string; icon?: SpriteName }[][] = [
  [{ label: 'Architecture' }, { label: 'ML inference', icon: 'chip' }, { label: 'Job queues' }],
  [{ label: 'iOS apps', icon: 'phoneSm' }, { label: 'Real-time 3D', icon: 'cube' }, { label: 'Metal shaders' }],
  [{ label: 'Vector search' }, { label: 'Cloud platform', icon: 'cloud' }, { label: 'Launch & growth', icon: 'rocket' }],
  [{ label: 'CI/CD' }, { label: 'Monitoring' }, { label: 'A/B testing' }],
];
const typedWords = ['product.', 'stack.', 'launch.', 'platform.'];

/* Capability panels, one per discipline in studio.ts. */
const layers = [
  {
    id: 'ml',
    tab: 'ML & GPU infrastructure',
    heading: 'Models in production. GPUs on demand.',
    links: ['npcmotion'],
  },
  {
    id: 'ios',
    tab: 'iOS & real-time graphics',
    heading: 'Native apps. Custom rendering underneath.',
    links: ['dicom-viewer-pro', 'ios-app-portfolio'],
  },
  {
    id: 'web',
    tab: 'Product & web',
    heading: 'Interfaces that stay fast under real load.',
    links: ['convertpoly', 'ai-audio-transcriber'],
  },
  {
    id: 'cloud',
    tab: 'Cloud & platform',
    heading: 'The platform under the product. Deploys made boring.',
    links: ['inventory-cloud-platform'],
  },
] as const;

/* Showcase: five case studies, each with its own card colour. */
const showcase = [
  { slug: 'npcmotion', bg: '#d3290f', ink: '#ffffff' },
  { slug: 'ios-app-portfolio', bg: '#ff5228', ink: '#101012' },
  { slug: 'ai-landscape-designer', bg: '#3eb67e', ink: '#101012' },
  { slug: 'dicom-viewer-pro', bg: '#0b6bd6', ink: '#ffffff' },
  { slug: 'convertpoly', bg: '#ffaf02', ink: '#101012' },
].map((s) => ({ ...s, project: bySlug[s.slug] }));
---

<Layout
  title="Salinash Studio — Product Engineering by Ali Siddique"
  description={studio.bio}
  ogType="website"
>
  <Header activePage="work" />

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="hero-arc" aria-hidden="true"></div>

      <div class="hero-gutter hero-gutter-left" aria-hidden="true">
        <div class="stack">
          <div class="blk" style="--c:var(--px-yellow);--i:2">
            <PixelArt name="robot" scale={4} class="blk-sprite" />
          </div>
          <div class="blk" style="--c:var(--px-amber);--i:1"></div>
          <div class="blk" style="--c:var(--px-crimson);--i:0"></div>
        </div>
      </div>

      <div class="hero-stage">
        <span class="eyebrow hero-eyebrow">{studio.name} · Independent product engineering · Est. {studio.founded}</span>
        <h1 class="hero-title">
          Salinash <PixelArt name="boat" scale={8} class="hero-boat" /> ships<br />
          whole products.
        </h1>
        <p class="hero-lede">
          The product engineering studio of {studio.principal}, from GPU inference to App Store
          launch. One exit. Six iOS apps. £50K+ in product revenue.
        </p>
        <div class="hero-actions">
          <a href="#work" class="hero-pill">
            <span class="hero-pill-icon"><PixelArt name="logo" scale={3} /></span>
            See the work
            <PixelArt name="chev" scale={2} class="chev" />
          </a>
          <a href="#studio" class="link-chev hero-link">
            Meet the studio
            <PixelArt name="chev" scale={2} class="chev" />
          </a>
        </div>

        <div class="floor" aria-hidden="true">
          <span class="floor-square"></span>
          <PixelArt name="phone" scale={4} class="floor-phone" />
          <PixelArt name="rack" scale={4} class="floor-rack" />
          <span class="floor-diamond"></span>
        </div>
      </div>

      <div class="hero-gutter hero-gutter-right" aria-hidden="true">
        <PixelArt name="satellite" scale={4} class="satellite" />
        <div class="stack">
          <span class="blk blk-diamond" style="--c:var(--px-red);--i:4"></span>
          <div class="blk" style="--c:var(--px-yellow);--i:3"></div>
          <div class="blk" style="--c:var(--px-orange);--i:2"></div>
        </div>
      </div>
    </section>

    <!-- Marquee -->
    <section class="marquee" aria-label="What the studio builds">
      <div class="marquee-track">
        {[0, 1].map((copy) => (
          <ul class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {marquee.map((m) => (
              <li class="mq-item">
                <PixelArt name={m.icon} scale={5} />
                {m.label}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>

    <!-- Studio -->
    <section class="studio" id="studio" aria-labelledby="studio-title">
      <div class="studio-mark" aria-hidden="true" data-reveal>
        <div class="studio-logo-wrap">
          <PixelArt name="logo" scale={40} class="studio-logo" />
        </div>
        <span class="studio-mark-caption">{studio.name} — Est. {studio.founded}</span>
      </div>
      <div class="studio-main">
        <span class="eyebrow">/ The studio</span>
        <h2 class="studio-statement" id="studio-title">
          {studio.name} is a product studio that ships whole products —
          <span class="studio-dim">architecture, infrastructure, interface, launch and growth.</span>
        </h2>
        <dl class="studio-facts">
          {facts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
            </div>
          ))}
        </dl>
        <div class="studio-actions">
          <a href="/about" class="btn">
            About the studio
            <PixelArt name="chev" scale={2} class="chev" />
          </a>
          <a href="/services" class="link-chev">
            Services
            <PixelArt name="chev" scale={2} class="chev" />
          </a>
        </div>
      </div>
    </section>

    <!-- Numbers -->
    <section class="numbers" aria-labelledby="numbers-title">
      <div class="numbers-head">
        <span class="eyebrow">/ The studio in numbers</span>
        <h2 class="statement numbers-title" id="numbers-title">
          Three years of independent practice,<br /> measured by what shipped.
        </h2>
      </div>
      <div class="numbers-grid">
        {metrics.map((m, i) => (
          <div class="number">
            <span class="number-value">{m.value}</span>
            <span class="number-label">
              <i style={`background-color:${ramp[i]}`}></i>
              {m.label}
            </span>
            <span class="number-detail">{m.detail}</span>
          </div>
        ))}
      </div>
      <div class="outcomes-grid">
        {outcomes.map((o) => (
          <div class="outcome">
            <span class="outcome-value">{o.value}</span>
            <span class="outcome-label">{o.label}</span>
            <span class="outcome-detail">{o.detail}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Strings -->
    <section class="strings">
      <svg class="strings-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <line x1="0" y1="34" x2="100" y2="58" />
        <line x1="0" y1="52" x2="100" y2="40" />
        <line x1="0" y1="62" x2="100" y2="92" />
        <line x1="0" y1="78" x2="100" y2="54" />
        <line x1="0" y1="90" x2="100" y2="74" />
        <line x1="0" y1="44" x2="100" y2="80" />
        <line x1="0" y1="98" x2="62" y2="58" />
        <line x1="100" y1="100" x2="38" y2="62" />
      </svg>

      <h2
        class="statement strings-title"
        aria-label={`One studio, every layer of your ${typedWords.join(' ').replace(/\./g, ',').replace(/,$/, '.')}`}
      >
        <span aria-hidden="true">One studio, every layer<br /> of your </span><span
          class="typed"
          aria-hidden="true"
          data-typed
          data-words={JSON.stringify(typedWords)}>{typedWords[0]}</span><span class="caret" aria-hidden="true"></span>
      </h2>

      <div class="strings-graph" aria-label="What the studio covers">
        {strings.map((row) => (
          <div class="strings-row">
            {row.map((node, n) => (
              <>
                {n > 0 && <i class="wire" aria-hidden="true"></i>}
                <span class:list={['string-node', { lit: !!node.icon }]}>
                  {node.icon && <PixelArt name={node.icon} scale={2} />}
                  {node.label}
                </span>
              </>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- Capabilities -->
    <section class="layers" aria-labelledby="layers-title">
      <h2 class="statement layers-title" id="layers-title">
        Salinash builds every layer<br /> your product runs on.
      </h2>

      <div class="layers-body">
        <aside class="layers-aside">
          <nav class="layers-nav" aria-label="Disciplines">
            {layers.map((l, i) => (
              <a href={`#layer-${l.id}`} class:list={['layers-tab', { active: i === 0 }]} data-layer-tab={l.id}>
                {l.tab}
                <PixelArt name="arrow" scale={2} class="tab-arrow" />
              </a>
            ))}
          </nav>
        </aside>

        <div class="layers-panels">
          {layers.map((l, i) => {
            const cap = capabilities[i];
            return (
              <article class="layer" id={`layer-${l.id}`} data-layer={l.id}>
                <div class="layer-text">
                  <span class="eyebrow">/ {cap.number} — {cap.title}</span>
                  <h3 class="layer-heading">{l.heading}</h3>
                  <p class="layer-body">{cap.summary}</p>
                  <ul class="layer-list">
                    {cap.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <div class="layer-links">
                    {l.links.map((slug) => (
                      <a href={`/work/${slug}`} class="link-chev">
                        Discover {bySlug[slug].title}
                        <PixelArt name="chev" scale={2} class="chev" />
                      </a>
                    ))}
                  </div>
                </div>
                <div class="layer-visual">
                  <CapabilityVisual variant={l.id} />
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Showcase -->
    <section class="showcase" aria-labelledby="showcase-title">
      <div class="showcase-head">
        <h2 class="statement showcase-title" id="showcase-title">See the work in production.</h2>
        <a href="#work" class="btn">
          All case studies
          <PixelArt name="chev" scale={2} class="chev" />
        </a>
      </div>

      <div class="showcase-body" data-showcase>
        <div class="showcase-tabs" role="tablist" aria-label="Featured case studies" aria-orientation="vertical">
          {showcase.map((s, i) => (
            <button
              type="button"
              role="tab"
              class="showcase-tab"
              id={`sc-tab-${s.slug}`}
              aria-controls={`sc-panel-${s.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-sc-tab={s.slug}
            >
              <span class="sc-tab-icon"><PixelArt name={projectIcon[s.slug]} scale={3} /></span>
              <span class="sc-tab-text">
                <span class="sc-tab-title">{s.project.title}</span>
                <span class="sc-tab-type">{s.project.type}</span>
              </span>
            </button>
          ))}
        </div>

        <div class="showcase-slides">
          {showcase.map((s, i) => {
            const [lead, ...rest] = s.project.results;
            return (
              <div
                class:list={['slide', { 'is-active': i === 0 }]}
                role="tabpanel"
                id={`sc-panel-${s.slug}`}
                aria-labelledby={`sc-tab-${s.slug}`}
                data-sc-panel={s.slug}
              >
                <div class="slide-stat">
                  <div class="slide-stat-top">
                    <PixelArt name={projectIcon[s.slug]} scale={6} />
                    <span class="eyebrow">{s.project.title} · {s.project.date}</span>
                  </div>
                  <div class="slide-stat-main">
                    <span class="slide-value">{lead.value}</span>
                    <span class="slide-label">{lead.label}</span>
                  </div>
                  <ul class="slide-more">
                    {rest.map((r) => (
                      <li>
                        <strong>{r.value}</strong> {r.label}
                      </li>
                    ))}
                  </ul>
                </div>
                <a
                  href={`/work/${s.slug}`}
                  class="slide-quote"
                  style={`--q-bg:${s.bg};--q-ink:${s.ink}`}
                >
                  <blockquote>“{s.project.headline}”</blockquote>
                  <span class="slide-cta">
                    Read the {s.project.title} case study
                    <PixelArt name="chev" scale={2} class="chev" />
                  </span>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- All work -->
    <section class="work" id="work" aria-labelledby="work-title">
      <div class="work-head">
        <h2 class="work-title" id="work-title">Selected work</h2>
        <p class="work-sub">
          {projects.length} case studies — ML infrastructure, iOS and graphics, cloud platforms and
          products taken to exit.
        </p>
      </div>
      <div class="work-grid">
        {projects.map((project) => (
          <ProjectCard
            slug={project.slug}
            number={project.number}
            title={project.title}
            subtitle={project.subtitle}
            type={project.type}
            context={project.context}
            date={project.date}
            status={project.status}
            summary={project.summary}
            visual={project.visual}
            href={`/work/${project.slug}`}
          />
        ))}
      </div>
    </section>

    <!-- Process -->
    <section class="process" aria-labelledby="process-title">
      <div class="process-head">
        <span class="eyebrow">/ How an engagement runs</span>
        <h2 class="statement process-title" id="process-title">
          Architecture first, a vertical slice second, and a launch that is measured.
        </h2>
      </div>
      <ol class="process-grid">
        {process.map((step, i) => (
          <li class="process-cell">
            <span class="process-meter" aria-hidden="true">
              {process.map((_, j) => (
                <i class:list={[{ on: j <= i }]}></i>
              ))}
            </span>
            <span class="process-num">{step.number}</span>
            <h3 class="process-step">{step.title}</h3>
            <p class="process-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Stack -->
    <section class="stack-section" aria-labelledby="stack-title">
      <div class="stack-head">
        <span class="eyebrow">/ Stack</span>
        <h2 class="stack-title" id="stack-title">What the work runs on.</h2>
      </div>
      <div class="stack-list">
        {stack.map((group) => (
          <div class="stack-row">
            <span class="stack-label">{group.label}</span>
            <div class="stack-tags">
              {group.items.map((item) => (
                <span class="node-tag">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Typed word in the strings headline */
  const typed = document.querySelector<HTMLElement>('[data-typed]');
  if (typed && !reduceMotion) {
    const words: string[] = JSON.parse(typed.dataset.words ?? '[]');
    let index = 0;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const run = async () => {
      for (;;) {
        await wait(2400);
        const current = words[index];
        for (let n = current.length; n >= 0; n--) {
          typed.textContent = current.slice(0, n);
          await wait(45);
        }
        index = (index + 1) % words.length;
        const next = words[index];
        await wait(200);
        for (let n = 1; n <= next.length; n++) {
          typed.textContent = next.slice(0, n);
          await wait(80);
        }
      }
    };

    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        run();
      }
    });
    io.observe(typed);
  }

  /* Studio mark builds itself when it scrolls into view */
  const reveal = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-in');
        reveal.unobserve(entry.target);
      }
    },
    { threshold: 0.35 }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => {
    el.classList.add('reveal-armed');
    reveal.observe(el);
  });

  /* Capability tabs follow the panel in view */
  const tabs = Array.from(document.querySelectorAll<HTMLElement>('[data-layer-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-layer]'));
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const id = (entry.target as HTMLElement).dataset.layer;
        tabs.forEach((t) => t.classList.toggle('active', t.dataset.layerTab === id));
      }
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );
  panels.forEach((p) => spy.observe(p));

  /* Showcase tabs */
  const scTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sc-tab]'));
  const scPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-sc-panel]'));

  const select = (slug: string, focus = false) => {
    scTabs.forEach((t) => {
      const on = t.dataset.scTab === slug;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    scPanels.forEach((p) => p.classList.toggle('is-active', p.dataset.scPanel === slug));
  };

  scTabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab.dataset.scTab!));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = scTabs[(i + step + scTabs.length) % scTabs.length];
      select(next.dataset.scTab!, true);
    });
  });
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: var(--gutter) 1fr var(--gutter);
    min-height: clamp(640px, calc(100svh - var(--nav-h)), 1000px);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-arc {
    position: absolute;
    width: 72vw;
    height: 72vw;
    left: -39vw;
    top: -52vw;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-gutter {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero-gutter-left {
    border-right: 1px solid var(--line);
  }

  .hero-gutter-right {
    border-left: 1px solid var(--line);
  }

  .stack {
    display: flex;
    flex-direction: column;
  }

  .blk {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background-color: var(--c);
    animation: drop 1s cubic-bezier(0.55, 0, 0.45, 1) both;
    animation-delay: calc(var(--i) * 0.14s + 0.15s);
  }

  .blk-diamond {
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }

  @keyframes drop {
    0% { transform: translateY(-120vh); }
    72% { transform: translateY(0); }
    84% { transform: translateY(-7%); }
    100% { transform: translateY(0); }
  }

  .blk :global(.blk-sprite) {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(28px, 40%, 56px);
    height: auto;
  }

  .hero-gutter-right :global(.satellite) {
    position: absolute;
    top: 2.5rem;
    left: 50%;
    width: clamp(36px, 48%, 68px);
    height: auto;
    translate: -50% 0;
    animation: bob 4.5s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(10px) rotate(3deg); }
  }

  .hero-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.25rem;
    padding: 5rem 1.5rem 9rem;
    text-align: center;
  }

  .hero-eyebrow {
    color: var(--muted);
  }

  .hero-title {
    font-family: var(--font-sans);
    font-size: clamp(3.25rem, 9.4vw, 11.5rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.05em;
  }

  .hero-lede {
    max-width: 52ch;
    font-size: clamp(1.0625rem, 1.45vw, 1.375rem);
    line-height: 1.5;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.25rem;
  }

  .hero-link {
    margin-left: 0;
  }

  .hero-title :global(.hero-boat) {
    display: inline-block;
    height: 0.74em;
    width: auto;
    vertical-align: -0.02em;
    margin: 0 0.04em;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.4rem 1.125rem 0.4rem 0.4rem;
    background-color: #141416;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    font-size: 1.0625rem;
    font-weight: 500;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .hero-pill:hover {
    background-color: var(--bg-hover);
    border-color: #4a4a52;
  }

  .hero-pill:hover :global(.chev) {
    transform: translateX(3px);
  }

  .hero-pill :global(.chev) {
    transition: transform 0.2s;
  }

  .hero-pill-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background-color: #0b0b0c;
    border-radius: 4px;
  }

  .floor {
    position: absolute;
    inset: auto 0 0 0;
    height: var(--gutter);
    pointer-events: none;
  }

  .floor > :global(*) {
    position: absolute;
    bottom: 0;
  }

  .floor-square {
    left: 11%;
    width: calc(var(--gutter) * 0.5);
    aspect-ratio: 1;
    background-color: var(--px-amber);
    animation: drop 1s cubic-bezier(0.55, 0, 0.45, 1) 0.8s both;
  }

  .floor :global(.floor-phone) {
    left: calc(11% + var(--gutter) * 0.5 + 1.5rem);
    width: clamp(22px, 2.6vw, 36px);
    height: auto;
  }

  .floor :global(.floor-rack) {
    right: calc(var(--gutter) + 9%);
    width: clamp(28px, 3vw, 44px);
    height: auto;
  }

  .floor-diamond {
    right: 0;
    width: var(--gutter);
    aspect-ratio: 1;
    background-color: var(--px-red);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    animation: drop 1s cubic-bezier(0.55, 0, 0.45, 1) 0.95s both;
  }

  /* ---------- Marquee ---------- */
  .marquee {
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  .marquee-group {
    display: flex;
  }

  .mq-item {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
    padding: clamp(1.75rem, 3.2vw, 3rem) clamp(1.75rem, 3.5vw, 3.5rem);
    border-right: 1px solid var(--line);
    font-size: clamp(2.25rem, 5.6vw, 6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .mq-item :global(svg) {
    width: clamp(36px, 4.4vw, 72px);
    height: auto;
  }

  /* ---------- Studio ---------- */
  .studio {
    display: grid;
    grid-template-columns: 38% 1fr;
    border-bottom: 1px solid var(--line);
  }

  .studio-mark {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.25rem, 4vw, 4rem);
    border-right: 1px solid var(--line);
  }

  /* A 7×7 ghost grid sitting exactly under the mark's pixels */
  .studio-logo-wrap {
    width: min(100%, 420px);
    aspect-ratio: 1;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: calc(100% / 7) calc(100% / 7);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .studio-mark :global(.studio-logo) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Rows of the mark pop in, top to bottom, when the section scrolls into view */
  .studio-mark :global(.studio-logo rect) {
    transition: opacity 0.25s steps(2, jump-none), transform 0.35s ease;
  }

  /* Hidden only once the script has armed the reveal, so the mark shows without JS */
  .studio-mark.reveal-armed:not(.is-in) :global(.studio-logo rect) {
    opacity: 0;
    transform: translateY(-0.6px);
  }

  .studio-mark.is-in :global(.studio-logo rect:nth-child(2)) { transition-delay: 0.08s; }
  .studio-mark.is-in :global(.studio-logo rect:nth-child(3)) { transition-delay: 0.16s; }
  .studio-mark.is-in :global(.studio-logo rect:nth-child(4)) { transition-delay: 0.24s; }
  .studio-mark.is-in :global(.studio-logo rect:nth-child(5)) { transition-delay: 0.32s; }
  .studio-mark.is-in :global(.studio-logo rect:nth-child(6)) { transition-delay: 0.4s; }
  .studio-mark.is-in :global(.studio-logo rect:nth-child(7)) { transition-delay: 0.48s; }

  .studio-mark-caption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .studio-main {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.25rem, 4vw, 4rem);
  }

  .studio-statement {
    font-size: clamp(2rem, 4vw, 4.25rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.04em;
    text-wrap: pretty;
  }

  .studio-dim {
    color: var(--muted);
  }

  .studio-facts {
    border-top: 1px solid var(--line);
  }

  .fact {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .fact dt {
    padding-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .fact dd {
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .fact dd a {
    text-decoration: underline;
    text-decoration-color: var(--px-orange);
    text-underline-offset: 5px;
  }

  .studio-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }

  .studio-actions .link-chev {
    margin-left: 0;
  }

  /* ---------- Numbers ---------- */
  .numbers {
    border-bottom: 1px solid var(--line);
  }

  .numbers-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(4.5rem, 9vw, 7.5rem) 1.25rem clamp(3.5rem, 6vw, 5rem);
    text-align: center;
    border-bottom: 1px solid var(--line);
  }

  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .number {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(2rem, 3.5vw, 3.25rem) clamp(1.25rem, 3vw, 3rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .number:nth-child(3n) {
    border-right: none;
  }

  .number-value {
    font-size: clamp(3.5rem, 7.2vw, 8rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.06em;
    white-space: nowrap;
  }

  .number-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .number-label i {
    width: 10px;
    height: 10px;
  }

  .number-detail {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .outcomes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .outcome {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem clamp(1.25rem, 3vw, 3rem) 2.25rem;
    border-right: 1px solid var(--line);
  }

  .outcome:last-child {
    border-right: none;
  }

  .outcome-value {
    font-size: clamp(2rem, 3.4vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--px-amber);
  }

  .outcome-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .outcome-detail {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ---------- Strings ---------- */
  .strings {
    position: relative;
    padding: clamp(5rem, 11vw, 9rem) 1.25rem clamp(5rem, 10vw, 8rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    text-align: center;
  }

  .strings-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .strings-lines line {
    stroke: #2a2a2e;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .strings-title {
    position: relative;
    margin: 0 auto clamp(3rem, 7vw, 5.5rem);
    max-width: 18ch;
    font-size: clamp(2.5rem, 6vw, 6.5rem);
  }

  .typed {
    color: var(--fg);
  }

  .caret {
    display: inline-block;
    width: 0.42em;
    height: 0.78em;
    margin-left: 0.06em;
    vertical-align: -0.04em;
    background-color: var(--px-orange);
    animation: caret 1s steps(2, jump-none) infinite;
  }

  @keyframes caret {
    50% { opacity: 0; }
  }

  .strings-graph {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  .strings-row {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wire {
    width: clamp(1.5rem, 4vw, 3.5rem);
    height: 1px;
    background-color: var(--line-strong);
  }

  .string-node {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1.25rem;
    border: 1px solid #1f1f23;
    background-color: rgba(16, 16, 18, 0.9);
    font-size: clamp(1rem, 1.6vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--dim);
    white-space: nowrap;
  }

  .string-node::before,
  .string-node::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2.5px;
    background-color: #4a4a50;
  }

  .string-node::before {
    left: -3px;
  }

  .string-node::after {
    right: -3px;
  }

  .string-node.lit {
    color: var(--fg);
    background-color: #18181b;
    border-color: #2c2c31;
  }

  .string-node.lit::before,
  .string-node.lit::after {
    background-color: var(--fg);
  }

  .string-node :global(svg) {
    width: 1.1em;
    height: auto;
  }

  /* ---------- Capability layers ---------- */
  .layers {
    border-bottom: 1px solid var(--line);
  }

  .layers-title {
    font-size: clamp(2.5rem, 5.6vw, 6rem);
    padding: clamp(4.5rem, 9vw, 7.5rem) 1.25rem clamp(4rem, 8vw, 6.5rem);
    text-align: center;
    border-bottom: 1px solid var(--line);
  }

  .layers-body {
    display: grid;
    grid-template-columns: 26% 1fr;
  }

  .layers-aside {
    border-right: 1px solid var(--line);
    padding: 3.5rem clamp(1.5rem, 3vw, 3.5rem);
  }

  .layers-nav {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    overflow: hidden;
  }

  .layers-tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.4rem;
    border-bottom: 1px solid var(--line-strong);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s, background-color 0.2s;
  }

  .layers-tab:last-child {
    border-bottom: none;
  }

  .layers-tab:hover {
    color: var(--fg);
    background-color: var(--bg-raised);
  }

  .layers-tab.active {
    color: var(--fg);
  }

  .layers-tab :global(.tab-arrow) {
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s, transform 0.2s;
  }

  .layers-tab.active :global(.tab-arrow) {
    opacity: 1;
    transform: none;
  }

  .layer {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.5fr);
    gap: clamp(2rem, 3.5vw, 3.5rem);
    align-items: center;
    padding: clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .layer:last-child {
    border-bottom: none;
  }

  .layer-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .layer-heading {
    font-size: clamp(1.625rem, 2.5vw, 2.375rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .layer-body {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--fg-soft);
  }

  .layer-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .layer-list li {
    position: relative;
    padding-left: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.6;
    color: var(--muted);
  }

  .layer-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    background-color: var(--px-orange);
  }

  .layer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 0.5rem;
  }

  .layer-visual {
    min-width: 0;
  }

  /* ---------- Showcase ---------- */
  .showcase {
    border-bottom: 1px solid var(--line);
  }

  .showcase-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(3.5rem, 6vw, 5rem) clamp(1.25rem, 3.5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .showcase-title {
    font-size: clamp(2.25rem, 5.4vw, 5.75rem);
  }

  .showcase-body {
    display: grid;
    grid-template-columns: 26% 1fr;
  }

  .showcase-tabs {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--line);
  }

  .showcase-tab {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 1.125rem;
    min-height: 6.5rem;
    padding: 1.25rem clamp(1.25rem, 3vw, 3.5rem);
    border: none;
    border-bottom: 1px solid var(--line);
    background: none;
    font: inherit;
    color: var(--muted);
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .showcase-tab:last-child {
    border-bottom: none;
  }

  .showcase-tab:hover {
    background-color: var(--bg-raised);
    color: var(--fg-soft);
  }

  .showcase-tab[aria-selected="true"] {
    background-color: #18181b;
    color: var(--fg);
  }

  .showcase-tab[aria-selected="true"]::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: var(--px-orange);
  }

  .showcase-tab :global(svg) {
    filter: grayscale(1) brightness(0.7);
    transition: filter 0.2s;
  }

  .showcase-tab[aria-selected="true"] :global(svg),
  .showcase-tab:hover :global(svg) {
    filter: none;
  }

  .sc-tab-icon {
    display: grid;
    place-items: center;
    width: 32px;
    flex-shrink: 0;
  }

  .sc-tab-text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .sc-tab-title {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .sc-tab-type {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dim);
  }

  .showcase-slides {
    padding: clamp(1.25rem, 3.5vw, 3.5rem);
  }

  .slide {
    display: none;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1.25rem;
    min-height: 100%;
  }

  .slide.is-active {
    display: grid;
    animation: slide-in 0.45s ease both;
  }

  @keyframes slide-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  .slide-stat {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
    border: 1px solid var(--line-strong);
    background-color: var(--bg);
  }

  .slide-stat-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .slide-stat-main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
  }

  .slide-value {
    font-size: clamp(2.75rem, 5vw, 4.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .slide-label {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--fg-soft);
  }

  .slide-more {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .slide-more li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.5;
    color: var(--muted);
  }

  .slide-more strong {
    font-weight: 500;
    color: var(--fg);
  }

  .slide-quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    min-height: clamp(360px, 34vw, 520px);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background-color: var(--q-bg);
    color: var(--q-ink);
  }

  .slide-quote blockquote {
    font-size: clamp(1.625rem, 2.9vw, 2.875rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  .slide-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .slide-cta :global(.chev) {
    transition: transform 0.2s;
  }

  .slide-quote:hover .slide-cta :global(.chev) {
    transform: translateX(4px);
  }

  /* ---------- All work ---------- */
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: clamp(3.5rem, 6vw, 5rem) clamp(1.25rem, 3.5vw, 3.5rem) 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .work-title {
    font-size: clamp(3.25rem, 12vw, 13rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .work-sub {
    max-width: 38ch;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-bottom: 1px solid var(--line);
  }

  .work-grid > :global(.project-card) {
    border-bottom: 1px solid var(--line);
  }

  .work-grid > :global(.project-card:nth-child(odd)) {
    border-right: 1px solid var(--line);
  }

  .work-grid > :global(.project-card:nth-last-child(-n + 2)) {
    border-bottom: none;
  }

  /* ---------- Process ---------- */
  .process {
    border-bottom: 1px solid var(--line);
  }

  .process-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(4.5rem, 9vw, 7rem) 1.25rem clamp(3.5rem, 6vw, 5rem);
    text-align: center;
    border-bottom: 1px solid var(--line);
  }

  .process-title {
    max-width: 22ch;
    font-size: clamp(2.25rem, 5vw, 5.25rem);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
  }

  .process-cell {
    display: flex;
