---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DisciplineIcons from '../components/DisciplineIcons.astro';

const mainProjects = [
  {
    title: "iOS App",
    type: "Product Design",
    context: "Freelance",
    date: "2024",
    image: "/images/hsn-teaser.png",
    imageAlt: "iOS app screens showing the main interface",
    href: "/work/ios-app"
  },
  {
    title: "Website",
    type: "Web Design",
    context: "Freelance",
    date: "2024",
    image: "/images/vola-teaser.png",
    imageAlt: "Website design mockup showing homepage layout",
    href: "/work/website"
  },
  {
    title: "Monday.com App",
    type: "App Design",
    context: "Freelance",
    date: "2024",
    image: "/images/mosidi-teaser.png",
    imageAlt: "Monday.com app interface showing dashboard and workflows",
    href: "/work/monday-app"
  }
];

const moreProjects = [
  {
    title: "A Statement On Editorial Shooting",
    type: "Client based",
    context: "Studies",
    date: "Aug / 2024",
    image: "/images/a-statement-teaser.png",
    imageAlt: "Flat mock-up of a double page of the book showing editorial content",
    href: "#"
  },
  {
    title: "Status Growth",
    type: "Fictional",
    context: "Studies",
    date: "Oct / 2024",
    image: "/images/status-growth-teaser.png",
    imageAlt: "Flat mock-up showing screen of interactive data visualisation",
    href: "#"
  }
];

const disciplines = [
  {
    number: "001",
    title: "Print",
    icon: "print" as const,
    items: ["Graphic design", "Layout", "Production"]
  },
  {
    number: "002",
    title: "Visual Identity",
    icon: "identity" as const,
    items: ["Concepting", "Visual systems", "Dynamic identity", "Documentation"]
  },
  {
    number: "003",
    title: "Interaction",
    icon: "interaction" as const,
    items: ["Digital Design", "Design Systems", "Prototyping", "Documentation"]
  },
  {
    number: "004",
    title: "Data Visualisation",
    icon: "data" as const,
    items: ["Dashboards", "Individual solutions", "Narratives"]
  }
];
---

<Layout title="Work — Jaqueline Grob – Designer, Digital & Brand">
  <Header activePage="work" />

  <!-- Intro Section -->
  <section class="intro-section">
    <div class="intro-grid">
      <div class="intro-empty"></div>
      <div class="intro-bio">
        <p>
          Grounded on a systemizing approach, Jaqueline Grob is a Potsdam-based creative exploring design projects in the intersection of technology and brands.
        </p>
      </div>
      <div class="intro-contact">
        <div class="contact-block">
          <span class="contact-label">Contact</span>
          <a href="mailto:hi@jackygrob.com" class="contact-email">hi@jackygrob.com</a>
          <span class="contact-location">Potsdam, Germany</span>
        </div>
        <div class="social-links">
          <a href="https://www.behance.net/jackygrob" target="_blank" rel="noopener" class="social-link">Behance</a>
          <a href="https://www.linkedin.com/in/jackygrob" target="_blank" rel="noopener" class="social-link">LinkedIn</a>
          <a href="https://www.xing.com/profile/Jaqueline_Grob" target="_blank" rel="noopener" class="social-link">Xing</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Work Title -->
  <section class="work-title-section">
    <h1 class="work-title">WORK ( - 2025)</h1>
  </section>

  <!-- Main Projects Grid -->
  <section class="projects-section">
    <div class="projects-grid">
      {mainProjects.map(project => (
        <ProjectCard
          title={project.title}
          type={project.type}
          context={project.context}
          date={project.date}
          image={project.image}
          imageAlt={project.imageAlt}
          href={project.href}
        />
      ))}
    </div>
  </section>

  <!-- Disciplines Section -->
  <section class="disciplines-section">
    <div class="disciplines-header">
      <h2 class="disciplines-headline">
        Exploring the intersection of brand experience and digital innovation – from webpages to visual systems.
      </h2>
      <p class="disciplines-sub">
        Throughout my studies and recent projects, the following disciplines have emerged and evolved as key areas of focus.
      </p>
    </div>
    <div class="disciplines-grid">
      {disciplines.map(d => (
        <div class="discipline-card">
          <div class="discipline-card-inner">
            <div class="discipline-text">
              <span class="discipline-number">/ {d.number}</span>
              <h3 class="discipline-title">{d.title}</h3>
              <ul class="discipline-list">
                {d.items.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="discipline-icon-wrap">
              <DisciplineIcons type={d.icon} />
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- More Work Section -->
  <section class="more-work-section">
    <h2 class="more-work-title">More work</h2>
    <div class="projects-grid">
      {moreProjects.map(project => (
        <ProjectCard
          title={project.title}
          type={project.type}
          context={project.context}
          date={project.date}
          image={project.image}
          imageAlt={project.imageAlt}
          href={project.href}
        />
      ))}
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Intro Section */
  .intro-section {
    border-bottom: 1px solid var(--color-stroke);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    min-height: 220px;
  }

  .intro-empty,
  .intro-bio,
  .intro-contact {
    padding: 1.75rem 1.25rem;
  }

  .intro-empty {
    border-right: 1px solid var(--color-stroke);
  }

  .intro-bio {
    border-right: 1px solid var(--color-stroke);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-black);
  }

  .intro-contact {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-block {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
    margin-bottom: 0.25rem;
  }

  .contact-email {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s;
  }

  .contact-email:hover {
    opacity: 0.6;
  }

  .contact-location {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-black);
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .social-link {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s;
  }

  .social-link:hover {
    opacity: 0.6;
  }

  /* Work Title */
  .work-title-section {
    padding: 1.5rem 0 0;
    overflow: hidden;
  }

  .work-title {
    font-family: var(--font-sans);
    font-size: clamp(4rem, 14vw, 13rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    padding: 0 0.5rem;
  }

  /* Projects Section */
  .projects-section {
    border-top: 1px solid var(--color-stroke);
  }

  .projects-section .projects-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .projects-section .projects-grid > :global(.project-card:nth-child(3n)) {
    border-right: none;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .projects-grid > :global(.project-card) {
    border-right: 1px solid var(--color-stroke);
    border-bottom: 1px solid var(--color-stroke);
  }

  /* More work 2-col: remove right border from even cards */
  .more-work-section .projects-grid > :global(.project-card:nth-child(even)) {
    border-right: none;
  }

  /* Disciplines Section */
  .disciplines-section {
    padding: 5rem 1.25rem;
    background-color: var(--color-gray-50);
    border-top: 1px solid var(--color-stroke);
    border-bottom: 1px solid var(--color-stroke);
  }

  .disciplines-header {
    max-width: 900px;
    margin-bottom: 4rem;
  }

  .disciplines-headline {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
  }

  .disciplines-sub {
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-gray-700);
  }

  .disciplines-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--color-stroke);
  }

  .discipline-card {
    border-right: 1px solid var(--color-stroke);
    border-bottom: 1px solid var(--color-stroke);
    background-color: var(--color-white);
  }

  .discipline-card:nth-child(even) {
    border-right: none;
  }

  .discipline-card:nth-child(3),
  .discipline-card:nth-child(4) {
    border-bottom: none;
  }

  .discipline-card-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1.75rem 1.5rem;
    min-height: 180px;
  }

  .discipline-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .discipline-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
  }

  .discipline-title {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .discipline-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .discipline-list li {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-black);
    position: relative;
    padding-left: 1rem;
  }

  .discipline-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-gray-700);
  }

  .discipline-icon-wrap {
    flex-shrink: 0;
    margin-left: 1rem;
  }

  /* More Work Section */
  .more-work-section {
    padding-top: 3rem;
    border-top: 1px solid var(--color-stroke);
  }

  .more-work-title {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.1;
    padding: 0 1.25rem 1.5rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }

    .intro-empty {
      display: none;
    }

    .intro-bio,
    .intro-contact {
      border-right: none;
      border-bottom: 1px solid var(--color-stroke);
    }

    .projects-grid,
    .projects-section .projects-grid {
      grid-template-columns: 1fr;
    }

    /* Restore all right borders in single-column mobile layout */
    .projects-grid > :global(.project-card),
    .projects-section .projects-grid > :global(.project-card:nth-child(3n)) {
      border-right: 1px solid var(--color-stroke);
    }

    .disciplines-grid {
      grid-template-columns: 1fr;
    }

    .discipline-card {
      border-right: none;
    }

    .discipline-card:nth-child(3),
    .discipline-card:nth-child(4) {
      border-bottom: 1px solid var(--color-stroke);
    }

    .discipline-card:last-child {
      border-bottom: none;
    }
  }
</style>
