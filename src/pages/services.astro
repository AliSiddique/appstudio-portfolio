---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PixelArt from '../components/PixelArt.astro';
import SectionHead from '../components/sections/SectionHead.astro';
import ProcessGrid from '../components/sections/ProcessGrid.astro';
import { studio, services, projects } from '../data/studio';
import type { SpriteName } from '../data/pixels';

/** Map each service to the shipped work that proves it. */
const proof: Record<string, string[]> = {
  '01': ['npcmotion', 'convertpoly', 'ios-app-portfolio'],
  '02': ['npcmotion', 'ai-audio-transcriber'],
  '03': ['dicom-viewer-pro', 'ios-app-portfolio'],
  '04': ['inventory-cloud-platform', 'npcmotion'],
};

const serviceIcon: Record<string, SpriteName> = {
  '01': 'rocket',
  '02': 'chip',
  '03': 'phoneSm',
  '04': 'cloud',
};

const terms: { title: string; body: string; icon: SpriteName; email?: boolean }[] = [
  {
    title: 'Direct access',
    body: 'You talk to engineering directly. No account managers, no brief passed down a chain.',
    icon: 'bolt',
  },
  {
    title: 'Owned end to end',
    body: 'Architecture, implementation, infrastructure and deployment come from one place, so nothing falls between contractors.',
    icon: 'cube',
  },
  {
    title: 'Shipped, not demoed',
    body: "Engagements end with something in the App Store or in production — the studio's own products were built to the same bar.",
    icon: 'rocket',
  },
  {
    title: 'Remote-first',
    body: 'Working with teams remotely. Reach the studio at',
    icon: 'satellite',
    email: true,
  },
];

const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
const startMailto = `mailto:${studio.email}?subject=${encodeURIComponent('New project')}`;
---

<Layout
  title="Services — Salinash Studio"
  description="What Salinash Studio builds: product builds, ML and GPU infrastructure, iOS and graphics engineering, and cloud platform work — each proven on shipped products."
  ogType="website"
>
  <Header activePage="services" />

  <main>
    <!-- Hero -->
    <section class="page-hero">
      <SectionHead eyebrow="/ Services" align="left" as="h1" size="xl">
        One studio, the whole stack.
        <Fragment slot="lede">
          Architecture, infrastructure, interface, launch. {studio.name} works the way a small
          product team does, without the handoffs — and every engagement below is something the
          studio has already shipped, not a capability list.
        </Fragment>
        <Fragment slot="actions">
          <a href={startMailto} class="btn btn-light">
            Start a project
            <PixelArt name="chev" scale={2} class="chev" />
          </a>
          <a href="/#work" class="link-chev">
            See the work
            <PixelArt name="chev" scale={2} class="chev" />
          </a>
        </Fragment>
      </SectionHead>

      <div class="hero-gutter" aria-hidden="true">
        <div class="gutter-stack">
          <span class="gutter-blk" style="--c:var(--px-amber);--i:3">
            <PixelArt name="rack" scale={4} class="gutter-sprite" />
          </span>
          <span class="gutter-blk" style="--c:var(--px-orange);--i:2"></span>
          <span class="gutter-blk" style="--c:var(--px-red);--i:1"></span>
          <span class="gutter-blk" style="--c:var(--px-crimson);--i:0"></span>
        </div>
      </div>
    </section>

    <!-- Engagements -->
    <section class="ruled" aria-labelledby="engagements-title">
      <SectionHead eyebrow="/ Engagements" id="engagements-title">
        Four ways to work<br /> with the studio.
      </SectionHead>

      <div class="services-list">
        {services.map((service) => (
          <article class="service-row" data-reveal-stagger="90">
            <div class="service-head">
              <PixelArt name={serviceIcon[service.number] ?? 'chip'} scale={4} />
              <span class="eyebrow">/ {service.number} — {service.tagline}</span>
              <h2 class="service-title">{service.title}</h2>
            </div>
            <div class="service-body">
              <p class="service-text">{service.body}</p>
              <ul class="square-list">
                {service.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="service-proof">
              <span class="eyebrow">/ Proven on</span>
              <div class="proof-links">
                {(proof[service.number] ?? []).map((slug) => (
                  <a href={`/work/${slug}`} class="link-chev proof-link">
                    {bySlug[slug].title}
                    <PixelArt name="chev" scale={2} class="chev" />
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Process -->
    <section class="ruled" aria-labelledby="process-title">
      <SectionHead eyebrow="/ How an engagement runs" id="process-title">
        Four stages, in the same order every time.
      </SectionHead>
      <ProcessGrid />
    </section>

    <!-- Working together -->
    <section aria-labelledby="terms-title">
      <SectionHead eyebrow="/ Working together" id="terms-title">
        What working with<br /> the studio is like.
      </SectionHead>
      <div class="terms-grid" data-reveal-stagger="90">
        {terms.map((t) => (
          <div class="term-cell">
            <PixelArt name={t.icon} scale={3} />
            <h3 class="term-title">{t.title}</h3>
            <p class="term-body">
              {t.body}
              {t.email && (
                <>
                  {' '}
                  <a href={`mailto:${studio.email}`} class="term-link">{studio.email}</a>.
                </>
              )}
            </p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .page-hero {
    display: grid;
    grid-template-columns: 1fr var(--gutter);
    min-height: clamp(520px, 72svh, 780px);
  }

  .page-hero > :global(.section-head) {
    justify-content: flex-end;
  }

  .hero-gutter {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-left: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .gutter-stack {
    display: flex;
    flex-direction: column;
  }

  .gutter-blk {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background-color: var(--c);
    animation: page-drop 1s cubic-bezier(0.55, 0, 0.45, 1) both;
    animation-delay: calc(var(--i) * 0.14s + 0.2s);
  }

  .gutter-blk :global(.gutter-sprite) {
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: clamp(26px, 36%, 44px);
    height: auto;
    translate: -50% 0;
  }

  @keyframes page-drop {
    0% { transform: translateY(-120vh); }
    72% { transform: translateY(0); }
    84% { transform: translateY(-7%); }
    100% { transform: translateY(0); }
  }

  .ruled {
    border-bottom: 1px solid var(--line);
  }

  /* ---------- Service rows ---------- */
  .service-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    padding: clamp(2.25rem, 4vw, 3.5rem) clamp(1.25rem, 3.5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .service-row:last-child {
    border-bottom: none;
  }

  .service-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .service-title {
    font-size: clamp(1.75rem, 3vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .service-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 0.25rem;
  }

  .service-text {
    max-width: 58ch;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--fg-soft);
  }

  .square-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .square-list li {
    position: relative;
    padding-left: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.6;
    color: var(--muted);
  }

  .square-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    background-color: var(--px-orange);
  }

  .service-proof {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  .proof-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .proof-link {
    padding-top: 0.55rem;
    padding-bottom: 0.55rem;
  }

  /* ---------- Working together ---------- */
  .terms-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .term-cell {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 2.25rem clamp(1.25rem, 2.5vw, 2.25rem) 2.75rem;
    border-right: 1px solid var(--line);
  }

  .term-cell:last-child {
    border-right: none;
  }

  .term-cell :global(svg) {
    margin-bottom: 0.75rem;
  }

  .term-title {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .term-body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .term-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--px-orange);
    text-underline-offset: 4px;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    .service-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    }

    .service-proof {
      grid-column: 1 / -1;
      padding-top: 1.25rem;
      border-top: 1px solid var(--line);
    }

    .proof-links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 1.5rem;
    }

    .terms-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .term-cell:nth-child(2n) {
      border-right: none;
    }

    .term-cell:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 700px) {
    .page-hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero-gutter {
      display: none;
    }

    .service-row {
      grid-template-columns: 1fr;
      padding: 2.25rem 1rem;
    }

    .terms-grid {
      grid-template-columns: 1fr;
    }

    .term-cell,
    .term-cell:nth-child(2n) {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .term-cell:last-child {
      border-bottom: none;
    }
  }
</style>
