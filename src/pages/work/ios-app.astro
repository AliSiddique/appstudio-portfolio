---
import WorkLayout from '../../layouts/WorkLayout.astro';
---

<WorkLayout
  title="iOS App"
  type="Product Design"
  context="Freelance"
  date="2024"
  role="UI / UX Design"
  number="001"
  metaDescription="A native iOS application designed with a focus on intuitive user experience and clean interface design."
  nextProject={{ title: "Website", href: "/work/website" }}
>
  <!-- Cover image -->
  <section class="project-cover">
    <div class="cover-img-wrap">
      <img src="/images/hsn-teaser.png" alt="iOS App — Cover" class="cover-img" loading="eager" />
    </div>
  </section>

  <!-- Overview -->
  <section class="project-overview">
    <div class="overview-grid">
      <div class="overview-left">
        <span class="section-label">/ Overview</span>
        <p class="overview-text">
          A native iOS application designed with a strong focus on intuitive user experience and clean interface design. Built following Apple's Human Interface Guidelines, the app delivers a seamless experience across all iPhone and iPad devices.
        </p>
        <p class="overview-text">
          The design process involved extensive user research, wireframing, and high-fidelity prototyping in Figma before handoff to development. Special attention was given to accessibility and motion design throughout.
        </p>
      </div>
      <div class="overview-right">
        <div class="detail-block">
          <span class="detail-block-label">/ Deliverables</span>
          <ul class="detail-list">
            <li>UI / UX Design</li>
            <li>Prototyping</li>
            <li>Design System</li>
            <li>App Store Assets</li>
            <li>Developer Handoff</li>
          </ul>
        </div>
        <div class="detail-block">
          <span class="detail-block-label">/ Screens</span>
          <ul class="detail-list">
            <li>Onboarding</li>
            <li>Dashboard</li>
            <li>Profile</li>
            <li>Settings</li>
            <li>Notifications</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="project-gallery">
    <p class="gallery-label">/ Screens</p>
    <div class="gallery-grid">
      <div class="gallery-item">
        <img src="/images/hsn-teaser.png" alt="iOS App — Onboarding" loading="lazy" class="gallery-img" />
      </div>
      <div class="gallery-item">
        <img src="/images/vola-teaser.png" alt="iOS App — Dashboard" loading="lazy" class="gallery-img" />
      </div>
      <div class="gallery-item">
        <img src="/images/mosidi-teaser.png" alt="iOS App — Profile" loading="lazy" class="gallery-img" />
      </div>
      <div class="gallery-item">
        <img src="/images/weave-up-teaser.png" alt="iOS App — Settings" loading="lazy" class="gallery-img" />
      </div>
    </div>
  </section>
</WorkLayout>
