---
import WorkLayout from '../../layouts/WorkLayout.astro';
---

<WorkLayout
  title="Monday.com App"
  type="App Design"
  context="Freelance"
  date="2024"
  role="UI / UX Design"
  number="003"
  metaDescription="A custom monday.com integration designed to streamline project workflows and unify team visibility across boards."
  nextProject={{ title: "iOS App", href: "/work/ios-app" }}
>
  <!-- Cover image -->
  <section class="project-cover">
    <div class="cover-img-wrap">
      <img src="/images/mosidi-teaser.png" alt="Monday.com App — Cover" class="cover-img" loading="eager" />
    </div>
  </section>

  <!-- Overview -->
  <section class="project-overview">
    <div class="overview-grid">
      <div class="overview-left">
        <span class="section-label">/ Overview</span>
        <p class="overview-text">
          A custom monday.com integration designed to streamline project workflows and provide teams with a unified view across boards. The app extends monday.com's native capabilities with tailored dashboards and automated reporting.
        </p>
        <p class="overview-text">
          The design focused on reducing friction for non-technical team members while giving project managers the depth of information they need — all within the familiar monday.com environment.
        </p>
      </div>
      <div class="overview-right">
        <div class="detail-block">
          <span class="detail-block-label">/ Deliverables</span>
          <ul class="detail-list">
            <li>UI / UX Design</li>
            <li>User Flows</li>
            <li>Component Library</li>
            <li>Interaction Design</li>
            <li>Documentation</li>
          </ul>
        </div>
        <div class="detail-block">
          <span class="detail-block-label">/ Features</span>
          <ul class="detail-list">
            <li>Custom Dashboards</li>
            <li>Automated Workflows</li>
            <li>Team Reports</li>
            <li>Third-party Integrations</li>
            <li>Notification System</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="project-gallery">
    <p class="gallery-label">/ Screens</p>
    <div class="gallery-grid">
      <div class="gallery-item">
        <img src="/images/mosidi-teaser.png" alt="Monday.com App — Dashboard" loading="lazy" class="gallery-img" />
      </div>
      <div class="gallery-item">
        <img src="/images/status-growth-teaser.png" alt="Monday.com App — Reports" loading="lazy" class="gallery-img" />
      </div>
      <div class="gallery-item">
        <img src="/images/weave-up-teaser.png" alt="Monday.com App — Workflows" loading="lazy" class="gallery-img" />
      </div>
      <div class="gallery-item">
        <img src="/images/vola-teaser.png" alt="Monday.com App — Settings" loading="lazy" class="gallery-img" />
      </div>
    </div>
  </section>
</WorkLayout>
