---
import WorkLayout from '../../layouts/WorkLayout.astro';
---

<WorkLayout
  title="Shopify App"
  type="App Development"
  context="Freelance"
  date="2024"
  role="Design & Development"
  number="005"
  metaDescription="A Shopify app built to extend store functionality — custom merchant dashboard, storefront integration, and a clean admin UI built on Polaris."
  nextProject={{ title: "iOS App", href: "/work/ios-app" }}
>
  <!-- Cover image -->
  <section class="project-cover">
    <div class="cover-img-wrap">
      <img src="/images/status-growth-teaser.png" alt="Shopify App — Cover" class="cover-img" loading="eager" />
    </div>
  </section>

  <!-- Overview -->
  <section class="project-overview">
    <div class="overview-grid">
      <div class="overview-left">
        <span class="section-label">/ Overview</span>
        <p class="overview-text">
          A custom Shopify app extending store functionality for merchants. Built with the Shopify App Bridge and Polaris design system, the app provides a familiar admin experience while adding powerful features merchants don't get out of the box.
        </p>
        <p class="overview-text">
          Includes a merchant-facing dashboard, storefront integration via Shopify's Theme App Extensions, and webhooks for real-time order processing. Submitted and approved on the Shopify App Store.
        </p>
      </div>
      <div class="overview-right">
        <div class="detail-block">
          <span class="detail-block-label">/ Deliverables</span>
          <ul class="detail-list">
            <li>Shopify App (Node.js)</li>
            <li>Admin UI (Polaris)</li>
            <li>Theme App Extension</li>
            <li>Webhook Integration</li>
            <li>App Store Listing</li>
          </ul>
        </div>
        <div class="detail-block">
          <span class="detail-block-label">/ Stack</span>
          <ul class="detail-list">
            <li>Node.js / TypeScript</li>
            <li>Shopify App Bridge</li>
            <li>Polaris</li>
            <li>Shopify API</li>
            <li>Webhooks</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="project-gallery">
    <p class="gallery-label">/ Screens</p>
    <div class="gallery-grid">
      <div class="gallery-item">
        <img src="/images/status-growth-teaser.png" alt="Shopify App — Dashboard" loading="lazy" class="gallery-img" />
      </div>
      <div class="gallery-item">
        <img src="/images/mosidi-teaser.png" alt="Shopify App — Admin" loading="lazy" class="gallery-img" />
      </div>
      <div class="gallery-item">
        <img src="/images/vola-teaser.png" alt="Shopify App — Storefront" loading="lazy" class="gallery-img" />
      </div>
      <div class="gallery-item">
        <img src="/images/hsn-teaser.png" alt="Shopify App — Settings" loading="lazy" class="gallery-img" />
      </div>
    </div>
  </section>
</WorkLayout>
